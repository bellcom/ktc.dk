;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Theme information
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

name        = 'KTC'
description = 'Subtheme of OS2web theme (a subtheme of Bootstrap), uses the LESS Bootstrap framework source files and must be compiled (not for beginners).'
core        = '7.x'
screenshot  = 'dist/images/screenshot.png'
base theme  = 'bootstrap'

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Regions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

regions[header_top]     = 'Header top'
regions[navigation]     = 'Navigation'
regions[header]         = 'Brugerboks'
regions[highlighted]    = 'Highlighted'
regions[help]           = 'Help'
regions[content]        = 'Content'
regions[sidebar_first]  = 'Primary'
regions[sidebar_second] = 'Secondary'
regions[footer]         = 'Footer 1'
regions[footer_2]       = 'Footer 2'
regions[footer_3]       = 'Footer 3'
regions[footer_4]       = 'Footer 4'
regions[footer_5]       = 'Footer 5'
regions[page_top]       = 'Page top'
regions[page_bottom]    = 'Page bottom'
regions[content_bottom] = 'Content bottom'

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Stylesheets
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

stylesheets[all][] = 'dist/css/stylesheet.css'

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Scripts
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

scripts[] = 'dist/js/modernizr.js'
scripts[] = 'dist/js/app.js'

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Plugins
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

plugins[panels][layouts] = 'layouts'

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Theme settings
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
