<?php
/**
 * @file
 * Code for the KTC content types feature.
 */

include_once 'ktc_content_types.features.inc';

function ktc_content_types_entity_info_alter(&$entity_info) {
  $entity_info['node']['view modes']['listevisning'] = array(
    'label' => t('Listevisning'),
    'custom settings' => TRUE,
  );
  $entity_info['node']['view modes']['listevisningstor'] = array(
    'label' => t('Listevisning Stor'),
    'custom settings' => TRUE,
  );
  $entity_info['node']['view modes']['listevisningboks'] = array(
    'label' => t('Listevisning boks'),
    'custom settings' => TRUE,
  );
  $entity_info['node']['view modes']['teasercomments'] = array(
    'label' => t('Teaser with comments'),
    'custom settings' => TRUE,
  );
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function ktc_content_types_form_node_form_alter(&$form, $form_state, $form_id) {
  // Properly hide hidden groups.
  ktc_content_types_field_group_hide_field_groups($form, array('group_hidden'));

  // Remove n/a from radio
  unset($form['field_hearing_official'][LANGUAGE_NONE]['#options']['_none']);

  if (isset($form['field_os2web_news_page_type'])) {
    $node = $form_state['node'];
    $vocabulary = taxonomy_vocabulary_machine_name_load('os2web_news_page_newstypes');
    $terms = taxonomy_get_tree($vocabulary->vid, 0, 1);
    $first_term = reset($terms);
    $options = array();

    if ((!isset($node->nid) || isset($node->is_new)) && user_access('administer all news type')) {
      // Get first item in vocabulary and set selects default value..
      $form['field_os2web_news_page_type']['und']['#default_value'][] = $first_term->tid;
    }
    elseif (!user_access('administer all news type')) {
      foreach ($terms as $tid => $term) {
        if (user_access('administer news type-' . $term->tid)) {
          $options[$term->tid] = $term->name;
        }
      }

      $form['field_os2web_news_page_type']['und']['#options'] = $options;
      $options_first = reset($options);
      $form['field_os2web_news_page_type']['und']['#default_value'][] = key($options_first);
    }
  }

  $vocabulary = taxonomy_vocabulary_machine_name_load('os2web_base_tax_promoteto');
  $terms = taxonomy_get_tree($vocabulary->vid, 0, 1);
  $first_term = reset($terms);
  $options = array();

  if (!user_access('promote to all the place')) {
    foreach ($terms as $tid => $term) {
      if (user_access('promote to-' . $term->tid)) {
        $options[$term->tid] = $term->name;
      }
    }
    $form['field_os2web_base_field_promote']['und']['#options'] = $options;
  }
}

/**
 * Hides field groups including children in a render array.
 *
 * @param array $element
 *   A render array. Can be a form, node, user, ...
 * @param array $group_names
 *   An array of field group names that should be hidden.
 */
function ktc_content_types_field_group_hide_field_groups(&$element, $group_names) {
  foreach ($group_names as $group_name) {
    if (isset($element['#fieldgroups'][$group_name]) && isset($element['#group_children'])) {
      // Hide the field group.
      $element['#fieldgroups'][$group_name]->format_type = 'hidden';
      // Hide the elements inside the field group.
      foreach (array_keys($element['#group_children'], $group_name) as $field_name) {
        $element[$field_name]['#access'] = FALSE;
      }
    }
  }
}

/**
 * Implements hook_permission().
 */
function ktc_content_types_permission() {
  $vocabulary = taxonomy_vocabulary_machine_name_load('os2web_news_page_newstypes');
  $terms = taxonomy_get_tree($vocabulary->vid, 0, 1);

  // A news all types administration permission.
  $permissions['administer all news type'] = array('title' => t('Administer alle nyhedstyper'));

  // Foreach news type term, there is a permission.
  foreach ($terms as $tid => $term) {
    $permissions['administer news type-' . $term->tid] = array(
      'title' => t('Administer ') . $term->name . t(' nyhedstype'),
    );
  }
  $vocabulary = taxonomy_vocabulary_machine_name_load('os2web_base_tax_promoteto');
  $terms = taxonomy_get_tree($vocabulary->vid, 0, 1);

  // A admin permission to promote news to all the place.
  $permissions['promote to all the place'] = array('title' => t('Forfrem til alle sted'));

  // Foreach promoting place, there is a permission.
  foreach ($terms as $tid => $term) {
    $permissions['promote to-' . $term->tid] = array(
      'title' => t('Forfrem til ') . $term->name,
    );
  }
  return $permissions;
}

/**
 * Publish/unpublish node form.
 */
function ktc_content_types_publish_node_form($form, $form_state, $nid, $status) {
  $new_status = $status == 'publish' ? 1 : 0;

  $form['status'] = array(
    '#type' => 'value',
    '#value' => $new_status,
  );

  $form['nid'] = array(
    '#type' => 'value',
    '#value' => $nid,
  );

  if ($new_status) {
    $form['submit'] = array(
      '#type' => 'submit',
      '#value' => 'Udgiv',
      '#attributes' => array('class' => array('btn-success')),
    );
  }
  else {
    $form['submit'] = array(
      '#type' => 'submit',
      '#value' => 'Træk tilbage',
      '#attributes' => array('class' => array('btn-warning')),
    );
  }

  return $form;
}

/**
 * Submit handler, publish/unpublish node.
 */
function ktc_content_types_publish_node_form_submit(&$form, &$form_state) {
  if ($node = node_load($form_state['values']['nid'])) {
    $node->status = $form_state['values']['status'];

    node_save($node);
  }
}

/**
 * Implements hook_preprocess_page().
 */
function ktc_content_types_preprocess_page(&$variables) {
  if (isset($variables['node']) && is_object($variables['node'])) {
    global $user;

    if ($variables['node']->uid == $user->uid) {
      if ($variables['node']->status) {
        $output = drupal_render(drupal_get_form('ktc_content_types_publish_node_form', $variables['node']->nid, 'unpublish'));
      }
      else {
        $output = '<div class="alert alert-danger" role="alert">';
        $output .= 'Denne side er kun gemt som kladde, og er skjult for alle andre. Du kan redigere indholdet ved at klikke på rediger, eller udgive indholdet ved at klikke på Udgiv.';
        $output .= drupal_render(drupal_get_form('ktc_content_types_publish_node_form', $variables['node']->nid, 'publish'));
        $output .= '</div>';
      }

      $variables['node_publish'] = array(
        '#markup' => $output,
      );
    }
  }
}
