/**
 * Implements hook_menu().
 */
function ktc_content_types_menu() {
  $items['node/%/unpublish'] = array(
    'title' => 'Afpublicér',
    'access callback' => 'ktc_content_types_unpublish_access',
    'access arguments' => array(1),
    'page callback' => 'ktc_content_types_unpublish_node',
    'type' => MENU_LOCAL_TASK,
  );

  return $items;
}

