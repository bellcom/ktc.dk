<?php
/**
 * @file
 * Code for the KTC sectionpage module.
 */

/**
 * Implements hook_menu().
 */
function ktc_sectionpage_menu() {
  $items['ajax/%/view/%/%/%/%/%/%'] = array(
    'page callback' => 'ktc_sectionpage_ajax_view',
    'access arguments' => array('access content'),
    'page arguments' => array(1, 3, 4, 5, 6, 7, 8),
  );
  $items['ajax/pane/subterms/view/%'] = array(
    'page callback' => 'ktc_subterms_filters_ajax_view',
    'access arguments' => array('access content'),
     'page arguments' => array(4,5)
  );
  $items['all_groups/%/%/%/%/%'] = array(
    'page callback' => 'ktc_sectionpage_ajax_all_groups_view',
    'access arguments' => array('access content'),
    'page arguments' => array(1, 2, 3, 4, 5),
  );

  $items['user/group/new_content'] = array(
    'page callback' => 'ktc_sectionpage_redirect_link',
    'access callback' => 'user_is_logged_in',
    'page arguments' => array(2),
  );

  $items['user/user_comments'] = array(
    'page callback' => 'ktc_sectionpage_redirect_link',
    'access callback' => 'user_is_logged_in',
    'page arguments' => array(1),
  );
  return $items;
}

/**
 * User menus callback.
 */
function ktc_sectionpage_redirect_link($page) {
  global $user;
  $goto = FALSE;
  switch ($page) {
    case 'new_content':
      $goto = 'user/' . $user->uid . '/group/new_content';
      break;

    case 'user_comments':
      $goto = 'user/' . $user->uid . '/user_comments';
      break;
  }

  if ($goto) {
    drupal_goto($goto);
  }
}

/**
 * All groups ajax view call back.
 */
function ktc_sectionpage_ajax_all_groups_view($f1, $f2, $f3, $f4, $f5 = 'all') {
  $term_type = _ktc_sectionpage_filter_helper($f1);
  $emner = _ktc_sectionpage_filter_helper($f2);
  $tags = _ktc_sectionpage_filter_helper($f3);
  $regioner = _ktc_sectionpage_filter_helper($f4);
  $view = views_get_view('section_page_filter_extra');

  switch ($f5) {
    case 'my,':
      $view->set_display('panel_pane_3');
      $f5_value = _ktc_sectionpage_group_filter_helper($f5);
      $view->set_arguments(array($term_type, $emner, $tags, $regioner, $f5_value));
      break;

    case 'all,':
      $view->set_display('panel_pane_3');
      $f5_value = _ktc_sectionpage_group_filter_helper($f5);
      $view->set_arguments(array($term_type, $emner, $tags, $regioner, $f5_value));
      break;
  }

  if ($f5 == 'newest') {
    $view->set_display('panel_pane_1');
    $view->set_arguments(array($term_type, $emner, $tags, $regioner, 'all'));
    $view->pre_execute();
    $view->execute();
    print $view->render('panel_pane_1');
  }
  else {
    $view->pre_execute();
    $view->execute();
    print $view->render('panel_pane_3');
  }

}

/**
 * Default ajax view call back.
 *
 * @param string $page
 *   last part in the url.
 *        string $f1 content_type
 *        string $f2: term_type (like document type, group type, news type ...)
 *        (arrangement type)
 *        string $f3: emner (field_topics) (period in arrangement page)
 *        string $f4: tags (field_tags) (date in arrangement page)
 *        string $f5: regioner
 *        string $gid: group ids.
 */
function ktc_sectionpage_ajax_view($page, $f1, $f2, $f3, $f4, $f5, $gid) {

  $output = _ktc_content_filter_view($page, $f1, $f2, $f3, $f4, $f5, $gid);

  if ($page == 'aktiviteter' || arg(0) == 'aktiviteter') {
    // $f2 in "aktiviteter" page is arrangement type term,
    // $f3 in "aktiviteter" page is period, as "fulture" or "old"
    // $4 is date, like 2014-12-16.
    $output = _ktc_section_block_arrangement_content($f2, $f3, $f4);
  }

  if ($page == 'hoeringer' || arg(0) == 'hoeringer') {
    $output = _ktc_section_block_hearing_content($f1, $f2, $f3, $f4, $f5, $gid);
  }
  
  if ($page == 'teknikmiljoe' || arg(0) == 'teknikmiljoe') {
    $output = _ktc_section_block_magazine_content($page, $f1, $f2, $f3, $f4, $f5, $gid);
  }
  print $output;

}

function ktc_subterms_filters_ajax_view($voc_id, $parent_id){   
  $parent_terms = _ktc_sectionpage_filter_helper($parent_id);
  $level = _ktc_sectionpage_helper_get_term_depth($parent_id);
  $view = views_get_view('section_page_filter');
  $view->set_display('panel_pane_4');
  $view->set_arguments(array($voc_id, $parent_terms));
  $view->pre_execute();
  $view->execute();
  if (count( $view->result )>0) {
  $output = '<div class="ktc-aside panel-pane pane-views-panes pane-section-page-filter-panel-pane-3 ktc-aside-checkbox-filter" id="emner-'.$level .'">
                <div class="ktc-aside-heading">
                    <h3 class="ktc-aside-title">Filtrer på faglige emner</h3>
                 </div>        
                <div class="ktc-aside-body pane-content">';
 $output .= $view->render('panel_pane_4');
 $output .='</div></div>';
 print $output;
 }
}

