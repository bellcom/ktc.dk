/**
 * Implements hook_block_view().
 */
function ktc_netvaerk_block_view($delta = '') {
  $block = array();

  switch ($delta) {
    case 'sidebar-group-members':
      $block['content'] = ktc_netvaerk_sidebar_group_members();
      $block['subject'] = t('MEDLEMMER AF ') . drupal_get_title();
      break;

    case 'sidebar-group-admins':
      $block['content'] = ktc_netvaerk_sidebar_group_members(TRUE);
      $block['subject'] = t('ADMINISTRATORER AF DETTE NETVÆRK');
      break;

    case 'group-members':
      $block['content'] = _ktc_netvaerk_og_members_list();
      break;

    case 'group-not-member-message':
      if (arg(0) == 'node' && is_numeric(arg(1))) {
        $gid = arg(1);
        if ($gid && !og_is_member('node', $gid)) {
          $state = ktc_netvaerk_group_state($gid);
          $message = ktc_netvaerk_state_message($state);
          $block['content'] = $message;
        }
      }
      break;

    case 'create-content':
      if (arg(0) == 'node' && is_numeric(arg(1))) {
        if ($group = node_load(arg(1))) {
          $block['subject'] = 'Opret nyt indhold i ' . $group->title;
          $block['content'] = ktc_netvaerk_create_content_links($group);
        }
      }
      break;
  }
  return $block;
}

/**
 *
 */
function ktc_netvaerk_sidebar_group_members($admins = FALSE) {
  $gid = arg(1);
  // Only proceed with generating the block if this is a group id.
  if (!is_numeric($gid)) {
    return;
  }

  $admin_user_roles = variable_get('ktc_users_grouproles_map', array());
  foreach ($admin_user_roles as $role_tid => $value) {
    if ($admins && $value) {
      $roles[] = $role_tid;
    }
    if (!$admins && !$value) {
      $roles[] = $role_tid;
    }
  }

  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'og_membership')
     ->propertyCondition('gid', $gid);

  if (!empty($roles)) {
    $query->fieldCondition('field_grouprole', 'target_id', $roles, 'IN');
  }

  $query->range(0, 5);
  $result = $query->execute();

  if ($result['og_membership']) {
    $memberships = og_membership_load_multiple(array_keys($result['og_membership']));

    foreach ($memberships as $membership) {
      if ($membership->etid == 1) {
        continue;
      }

      $user = user_load($membership->etid);
      if (!is_object($user)) {
        continue;
      }

      $list .= render(user_view($user, 'list3'));
    }
  }
  if (!$admins) {
    $list .= '<div class="og-members-all ktc-call-to-action-button"><a href="#" class="btn btn-default">Se alle medlemmer</a></div>';
  }
  return $list;
}

/**
 * Return an array of urls for nodes that can be created in a network.
 */
function ktc_netvaerk_create_content_links($group) {
  global $user;

  if (!$user->uid || !og_is_member('node', $group->nid)) {
    return FALSE;
  }

  $nid = $group->nid;
  $hearing_link = '';

  // Link to adding hearings to a group is only added if it is a
  // "faggruppe".
  if ($field = field_get_items('node', $group, 'field_netvaerkstype')) {
    if ($field[0]['tid'] == 1134) {
      $hearing_link = '<div class="ktc-link-wrapper"><div class="ktc-link-container"><a class="ktc-link-with-icon ktc-link-with-icon-large ktc-link-icon-hearing" href="/node/add/hearing?og_group_ref=' . $nid . '">Høring</a></div></div>';
    }
  }

  $links = <<<EOL
  <div class="ktc-link-wrapper">
      <div class="ktc-link-container">
        <a href="/node/add/meeting-doodle?og_group_ref=$nid" class="ktc-link-with-icon ktc-link-with-icon-large ktc-link-icon-meeting_doodle">Afstemning</a>
      </div>
      <div class="ktc-link-container">
        <a href="/node/add/arrangement?og_group_ref=$nid" class="ktc-link-with-icon ktc-link-with-icon-large ktc-link-icon-arrangement">Arrangement</a>
      </div>
      <div class="ktc-link-container">
        <a href="/node/add/forum-post?og_group_ref=$nid" class="ktc-link-with-icon ktc-link-with-icon-large ktc-link-icon-forum_post">Diskussion</a>
      </div>
  </div>
  <div class="ktc-link-wrapper">
      <div class="ktc-link-container">
        <a href="/node/add/document?og_group_ref=$nid" class="ktc-link-with-icon ktc-link-with-icon-large ktc-link-icon-document">Dokument</a>
      </div>
      <div class="ktc-link-container">
        <a href="/node/add/group?og_group_ref=$nid" class="ktc-link-with-icon ktc-link-with-icon-large ktc-link-icon-subnetwork">Undernetværk</a>
      </div>
      <div class="ktc-link-container">
        <a href="/node/add/os2web-base-news?og_group_ref=$nid" class="ktc-link-with-icon ktc-link-with-icon-large ktc-link-icon-os2web_base_news">Nyhed</a>
      </div>
  </div>
  $hearing_link
EOL;

  return $links;
}

/**
 * Get netvaerk openess.
 */
function ktc_netvaerk_group_state($gid) {
  $group_node = node_load($gid);

  $open = 0;
  $access = 0;

  if ($field = field_get_items('node', $group_node, 'field_open_group')) {
    $open = $field[0]['value'];
  }
  if ($field = field_get_items('node', $group_node, 'group_content_access')) {
    $access = $field[0]['value'];
  }

  if ($open) {
    return KTC_NETVAERK_GROUP_OPEN;
  }
  else {
    if ($access == 1) {
      return KTC_NETVAERK_GROUP_CLOSED_VISIBLE;
    }
    else {
      return KTC_NETVAERK_GROUP_CLOSED_HIDDEN;
    }
  }
}

/**
 * Get message for given state.
 */
function ktc_netvaerk_state_message($state) {
  return variable_get('ktc_netvaerk_state_message-' . $state);
}

/**
 * KTC netvaerk get node group info.
 */
function ktc_netvaerk_get_node_group_info($nid) {
  $group_info = array('name' => '', 'class' => '', 'gid' => '');
   if (is_numeric($nid)) {
    $node = node_load($nid);
    if ($gid = field_get_items('node', $node, 'og_group_ref')) {
      $gid = $gid[0]['target_id'];
      $group = node_load($gid);
      $class = ktc_netvaerk_check_my_groups($gid);
      // TODO: get class green for some specific group type.
      /*$tid = '';
      if ($group_type = field_get_items('node', $group, 'field_netvaerkstype')){
      $tid = $group_type[0]['tid'];

      }*/
      $group_info = array(
        'name' => $group->title,
        'class' => $class,
        'gid' => $gid,
      );
    }

    // If the node type is a group.
    if ($node->type == 'group') {
      // Check user is a member or not.
      $class = ktc_netvaerk_check_my_groups($nid);
      $group_info = array(
        'name' => $node->title,
        'class' => $class,
        'gid' => $gid,
      );
      // TODO: the forengingen(green).
    }
    // If node type is magazine, so there is no group,
    // return class is blue.
    if ($node->type == 'magazine') {
      $group_info = array('name' => 'magazine', 'class' => 'ktc-blue');
    }
  }
  return $group_info;

}
/**
 * Check group, add classes.
 */
function ktc_netvaerk_check_my_groups($nid) {
  // Yellow is the genernal group.
  $class = 'ktc-gold';
  ;
  $node = node_load($nid);
  $ktc_green_network_tids = array(1133, 1134, 1155);

  if ($gids = og_get_groups_by_user()) {
    if (in_array($nid, $gids['node'])) {
      // Red is my group.
      $class = 'ktc-red';
    }
  }

  if ($class != 'ktc-red') {
    if ($field_network_type = field_get_items('node', $node, 'field_netvaerkstype')) {
      foreach($ktc_green_network_tids AS $ktc_green_network_tid) {
        if (in_array($ktc_green_network_tid, $field_network_type[0])) {
          $class = 'ktc-green';
        }
      }
    }
  }

  // Check group content visibility.
  if (is_object($node) && $visible = field_get_items('node', $node, 'og_roles_permissions')) {
    if ($visible[0]['value']) {
      $class .= ' private-content';
    }
  }
  return $class;
}

/**
 * Implements hook_node_insert().
 */
function ktc_netvaerk_node_insert($node) {
  if ($node->type == 'group') {
    $old_uid = $node->uid;
    // Auto add user membership.
    $account = user_load($old_uid);
    // Add the user to the group.
    og_group('node', $node->nid, array(
                "entity type"       => "user",
                "entity"        => $account,
                "membership type"   => OG_MEMBERSHIP_TYPE_DEFAULT,
            ));
    // Changes the users role in the group
    // (1 = non-member, 2 = member, 3 = administrator member).
    og_role_grant('node', $node->nid, $account->uid, 3);

    // Update node: add global owner to group.
    ktc_netvaerk_change_own($node);
  }
}

/**
 * Chang group owner.
 */
function ktc_netvaerk_change_own($node) {
  if ($node->type == 'group') {
    $name = variable_get('group_owner', 'netvaerk@ktc.dk');
    if ($owner = user_load_by_name($name)) {
      db_update('node')->fields(array('uid' => $owner->uid))->condition('nid', $node->nid)->execute();
    }
  }
}
/**
 * Get group content types.
 */
function ktc_netvaerk_get_group_content_types($nid = 'all') {
  $types = array();
  if (is_numeric($nid)) {
    $query = db_select('og_membership', 'ogm');
    $query->join('node', 'n', 'n.nid = ogm.etid');
    $query->distinct()
          ->fields('n', array('type'))
          ->condition('ogm.gid', $nid, '=')
          ->condition('ogm.entity_type', 'node', '=');
    $result = $query->execute();
    if ($result->rowCount() > 0) {
      while ($record = $result->fetchAssoc()) {
        if ($record['type'] == 'group') {
          continue;
        }
        $types[] = $record['type'];
      }
    }
  }
  if ($nid == 'all') {
      
    $node_types = node_type_get_types();
    foreach ($node_types as $obj) {
      // Skip hearing_responses type.
      if ($obj->type == 'hearing_responses' || $obj->type == 'group') {
        continue;
      }
      if (og_is_group_content_type('node', $obj->type)) {
        $types[] = $obj->type;
      }
    }
  }
  return $types;
}

/**
 * Implements hook_node_validate().
 */
function ktc_netvaerk_node_validate($node, $form, &$form_state) {

  if ($node->type == 'group') {
    // Get users groups.
    $gids = og_get_groups_by_user();

    // Check if user has 'create top group' permission.
    $create_top_group = user_access('create ktc top group');
    // Top group field.
    $og_group_ref = isset($form_state['values']['og_group_ref']) ? $form_state['values']['og_group_ref'] : FALSE;
    if (!$create_top_group) {
      // If the user cannot create top group,
      // so the og_group_ref field cannot be empty.
      if (!$og_group_ref) {
        form_set_error('og_group_ref', t('Du skal vælge et overstående netværk.'));
      }
      if (isset($og_group_ref['und'][0]['target_id'])) {
        // Check if user is a member of the chosen group.
        if (!in_array($og_group_ref['und'][0]['target_id'], $gids['node'])) {
          form_set_error('og_group_ref', t('Du er ikke medlem af det netværk.'));
        }
      }
      else {
        form_set_error('og_group_ref', t('Du skal vælge et overstående netværk.'));
      }
    }
  }
}

/**
 * Implements hook_node_presave().
 */
function ktc_netvaerk_node_presave($node) {
  if ($node->type == 'group') {
    // Depending on the group type, we set the open status of the node to
    // closed.
    if ($field = field_get_items('node', $node, 'field_netvaerkstype')) {
      $type_closed = variable_get('ktc_netvaerk_type_closed', array());

      if (in_array($field[0]['tid'], array_values($type_closed))) {
        // Set the value for the field.
        $lang = field_language('node', $node, 'field_netvaerkstype');
        $node->field_open_group[$lang][0]['value'] = 0;
      }
    }
  }
}

/**
 * Implements hook_permission().
 */
function ktc_netvaerk_permission() {
  return array(
    'create ktc top group' => array(
      'title' => t('Opret ktc top netværk'),
      'description' => t('Opret ktc top netværk som ktc admin.'),
    ),
  );
}

/**
 * Implements hook_menu_alter().
 */
function ktc_netvaerk_menu_alter(&$items) {
  // Change theme these pages.
  $items['node/add/group']['theme callback'] = 'ktc_netvaerk_get_default_theme';
  $items['group/%/%/admin/people/invite-users']['theme callback'] = 'ktc_netvaerk_get_default_theme';
  $items['node/%/group']['theme callback'] = 'ktc_netvaerk_get_default_theme';
  $items['group/%/%/admin/people/add-user']['theme callback'] = 'ktc_netvaerk_get_default_theme';
}
/**
 * Get default theme callback.
 */
function ktc_netvaerk_get_default_theme() {
  return variable_get('theme_default', '0');
}

/**
 * Implements hook_theme().
 */
function ktc_netvaerk_theme($existing, $type, $theme, $path) {
  $path = 'theme/';
  return array(
    'ktc_netvaerk_invite_form' => array(
      'render element' => 'form',
      'template' => $path . 'ktc-netvaerk-invite-form',
    ),
  );
}
/**
 * Implements hook_form_alter().
 */
function ktc_netvaerk_form_alter(&$form, $form_state, $form_id) {
  if (in_array($form_id, array('og_ui_edit_membership', 'og_ui_add_users'))) {
    // The roles on the membership, are all set using ktc_users_roles.
    // So we hide this form item.
    $form['og_user']['roles']['#access'] = FALSE;

    // These fields only contain data for display, we hide the fields
    // because the user should not be able to change the data.
    $form['membership_fields']['field_crm_uuid']['#access'] = FALSE;
    $form['membership_fields']['field_grouprole']['#access'] = FALSE;

    // Instead of letting the user set the role directly, we give them the
    // oppurtunity to select a mock role. This will allow the editing user to
    // set the members membershiptype to 'Netværksadministrator' which in turn
    // will result in the user getting the role 'administrator member' in the
    // group thanks to ktc_users_roles module.
    $grouprole_tid = KTC_NETVAERK_MEMBER_TID;

    if (og_user_access($form['group_type']['#value'], $form['gid']['#value'], 'administer group')) {
      $disabled = FALSE;
      $value = FALSE;

      $grouprole_map = variable_get('ktc_users_grouproles_map', array());

      if (isset($form['membership_fields']['field_grouprole'][LANGUAGE_NONE]['#default_value'][0])) {
        $grouprole_tid = $form['membership_fields']['field_grouprole'][LANGUAGE_NONE]['#default_value'][0];

        // Determine the default_value for the checkbox - if the current grouprole
        // grants the "administrator member" role.
        $value = (bool) ($grouprole_map[$grouprole_tid]);

        // It is only the "Netværksadministrator" and "Member" grouptypes that
        // are allowed updated from drupal.
        if (!in_array($grouprole_tid, array(23221, 23224))) {
          $disabled = TRUE;
        }
      }

      $form['ktc_netvaerk_administrator'] = array(
        '#type' => 'checkbox',
        '#title' => 'Netværksadministrator',
        '#description' => 'Denne bruger skal være netværksadministrator',
        '#disabled' => $disabled,
        '#default_value' => $value,
      );

      if ($disabled) {
        $form['ktc_netvaerk_administrator']['#prefix'] = '<em>Medlemmet har en rolle der ikke tillader ændring.</em>';
      }
      $form['#validate'][] = 'ktc_netvaerk_og_membership_validate';
    }

    $grouprole = taxonomy_term_load($grouprole_tid);
    $form['ktc_netvaerk_grouprole'] = array(
      '#type' => 'item',
      '#title' => t('Brugerens nuværende rolle'),
      '#markup' => $grouprole->name,
    );
  }

  if ($form_id == 'group_node_form') {
    unset($form['field_open_group'][LANGUAGE_NONE]['#options']['_none']);

    if (isset($form_state['entityreference_prepopulate'])) {
      drupal_set_title('Opret Undernetværk');
    }

    // Can't make ktc_content_types_field_group_hide_field_groups work
    // on these two fields. Hide with CSS instead.
    $form['og_roles_permissions']['#attributes']['class'][] = 'hide';
    $form['group_access']['#attributes']['class'][] = 'hide';
  }

  if ($form_id == 'og_ui_confirm_subscribe') {
    $form['field_grouprole']['#access'] = FALSE;
  }
}

/**
 * Extra validation handler for creating/editing an og_membership.
 */
function ktc_netvaerk_og_membership_validate(&$form, &$form_state) {
  // Skip changing grouprole if there are other errors.
  if (form_get_errors()) {
    return;
  }

  // If the user has permissions to change the grouprole (the form item is
  // shown). And the checkbox is not disabled.
  if (isset($form['ktc_netvaerk_administrator']) && !$form['ktc_netvaerk_administrator']['#disabled']) {
    if ($form_state['values']['ktc_netvaerk_administrator']) {
      // The grouprole for the membership should be updated to
      // "netvaerksadministrator".
      $form_state['values']['membership_fields']['field_grouprole'][LANGUAGE_NONE][0]['target_id'] = KTC_NETVAERK_ADMIN_TID;
    }
    else {
      // Otherwise it's just a normal Member.
      $form_state['values']['membership_fields']['field_grouprole'][LANGUAGE_NONE][0]['target_id'] = KTC_NETVAERK_MEMBER_TID;
    }
  }
}

/**
 * Generate block content for 'group-members'.
 */
function _ktc_netvaerk_og_members_list() {
  $gid = arg(1);
  // Only proceed with generating the block if this is a group id.
  if (!is_numeric($gid)) {
    return;
  }

  module_load_include('inc', 'og_ui', 'og_ui.admin');
  drupal_add_js(drupal_get_path('module', 'ktc_netvaerk') . '/js/ktc_netvaerk.group.js');

  $view = views_get_view('ktc_og_members');
  $view->set_display('block_2');
  $view->set_arguments(array($gid));
  $view->pre_execute();
  $view->execute();
  $view_markup = $view->render();

  $add_users = '';
  $view_markup_pending = '';

  // Only show pending users and add form to users with administer group
  // permissions.
  if (og_user_access('node', $gid, 'administer group')) {
    $view = views_get_view('ktc_og_members');
    $view->set_display('block_3');
    $view->set_arguments(array($gid));
    $view->pre_execute();
    $view->execute();
    $view_markup_pending = $view->render();

    $add_users = '<p><a href="#" class="js-form-add-user btn"><span class="glyphicon glyphicon-plus"></span> Tilføj nyt medlem</a>';
    $add_users .= '<a href="#" class="js-form-massadd-user btn"><span class="glyphicon glyphicon-plus"></span> Inviter pr. email adresse</a></p>';

    // Get og add user form.
    $form = drupal_get_form('og_ui_add_users', 'node', $gid);
    // Hide request message.
    $form['membership_fields']['og_membership_request']['#access'] = FALSE;
    $form['actions']['submit']['#value'] = t('Tilføj medlem');

    $add_users .= '<div id="form-add-user" class="well well-sm hide">' . drupal_render($form) . '</div>';

    // Get og mass add user form.
    $form = drupal_get_form('og_massadd_massadd_form', 'node', $gid);

    $add_users .= '<div id="form-massadd-user" class="well well-sm hide">' . drupal_render($form) . '</div>';

    if ($view->result) {
      $view_markup_pending = '<p><b>Afventer godkendelse</b></p>' . $view_markup_pending;
    }
  }

  // Show messages in the modal.
  $messages = theme('status_messages', drupal_get_messages(NULL, FALSE));

  $modal_markup = <<<EOL
<div class="modal fade" id="member-modal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title">Netværkets medlemmer</h4>
      </div>
      <div class="modal-body">
        $messages
        $add_users
        <div id="form-div" class="hide well well-sm">
          <a class="close" data-dismiss="alert" href="#">×</a>
          <div>
            <center>...</center>
          </div>
        </div>

        <div class="content">
          <p><b>Godkendte medlemmer</b></p>
          $view_markup
          $view_markup_pending
        </div>
      </div>
    </div>
  </div>
</div>
EOL;

  return $modal_markup;
}
