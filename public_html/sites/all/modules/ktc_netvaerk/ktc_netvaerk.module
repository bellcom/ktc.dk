<?php
/**
 * @file
 * Code for the KTC netværk feature.
 */

// Status of an open group.
define('KTC_NETVAERK_GROUP_OPEN', 1);
// Status of a closed group with visible content.
define('KTC_NETVAERK_GROUP_CLOSED_VISIBLE', 2);
// Status of a closed group with hidden content.
define('KTC_NETVAERK_GROUP_CLOSED_HIDDEN', 3);

include_once 'ktc_netvaerk.features.inc';

/**
 * Implements hook_menu().
 */
function ktc_netvaerk_menu() {
  $items['admin/netvaerk_setting'] = array(
    'type' => MENU_NORMAL_ITEM,
    'title' => 'Netværk settings',
    'description' => 'Configure group settings',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('ktc_netvaerk_settings'),
    'access arguments' => array('access administration pages'),
  );
  return $items;
}
/**
 * KTC netvaerk setting form.
 */
function ktc_netvaerk_settings() {
  $form = array();

  $form['group_owner'] = array(
    '#type' => 'textfield',
    '#title' => t('Grupper ejer'),
    '#description' => t('Global grupper ejer'),
    '#size' => 30,
    '#default_value' => variable_get('group_owner', ''),
    '#autocomplete_path' => 'user/autocomplete',
  );

  $form['netvaerk_not_member'] = array(
    '#title' => t('Beskeder til brugere der ikke er medlem af netværket'),
    '#type' => 'fieldset',
  );

  $var_name = 'ktc_netvaerk_state_message-' . KTC_NETVAERK_GROUP_OPEN;
  $form['netvaerk_not_member'][$var_name] = array(
    '#type' => 'textarea',
    '#title' => t('Besked på åbent netværk'),
    '#default_value' => variable_get($var_name),
  );

  $var_name = 'ktc_netvaerk_state_message-' . KTC_NETVAERK_GROUP_CLOSED_VISIBLE;
  $form['netvaerk_not_member'][$var_name] = array(
    '#type' => 'textarea',
    '#title' => t('Besked på (lukket)netværk hvor der skal anmodes om medlemsskab'),
    '#default_value' => variable_get($var_name),
  );

  $var_name = 'ktc_netvaerk_state_message-' . KTC_NETVAERK_GROUP_CLOSED_HIDDEN;
  $form['netvaerk_not_member'][$var_name] = array(
    '#type' => 'textarea',
    '#title' => t('Besked på (lukket)netværk hvor der ikke kan anmodes om medlemsskab'),
    '#default_value' => variable_get($var_name),
  );

  return system_settings_form($form);
}

/**
 * Implements hook_token_info().
 */
function ktc_netvaerk_token_info() {
  $info['tokens']['node']['ktc-netvaerk-url'] = array(
    'name' => t('OG Group-url'),
    'description' => t('URL for og group reference.'),
  );

  $info['tokens']['node']['ktc-content'] = array(
    'name' => t('Indhold'),
    'description' => t('Indholdet af noden'),
  );
  return $info;
}

/**
 * Implements hook_tokens().
 */
function ktc_netvaerk_tokens($type, $tokens, array $data = array(), array $options = array()) {
  $replacements = array();
  $sanitize = !empty($options['sanitize']);

  if ($type == 'node' && !empty($data['node'])) {
    $node = $data['node'];

    foreach ($tokens as $name => $original) {
      switch ($name) {
        case 'ktc-netvaerk-url':
          if ($field = field_get_items('node', $node, 'og_group_ref')) {
            $options = array('absolute' => TRUE);
            $replacements[$original] = url('node/' . reset($field)['target_id'], $options);
          }
          break;

        case 'ktc-content':
          $replacements[$original] = '';

          if ($field = field_get_items('node', $node, 'body')) {
            if ($field[0]['summary']) {
              $replacements[$original] = $field[0]['safe_summary'];
            }
            else {
              $replacements[$original] = text_summary($field[0]['safe_value']);
            }
          }
          break;
      }
    }
  }

  return $replacements;
}

/**
 * Implements hook_block_info().
 */
function ktc_netvaerk_block_info() {
  $blocks['group-members'] = array(
    'info' => t('KTC Netværk, Gruppe medlemmer modal'),
    'cache' => DRUPAL_NO_CACHE,
  );

  $blocks['group-not-member-message'] = array(
    'info' => t('KTC Netværk, Besked til besøgende der ikke er medlem af netværket'),
  );
  return $blocks;
}

/**
 * Implements hook_block_view().
 */
function ktc_netvaerk_block_view($delta = '') {
  $block = array();

  switch ($delta) {
    case 'group-members':
      $view = views_get_view('ktc_og_members');
      $view->set_display('block_2');
      $view->set_arguments(array(arg(1)));
      $view->pre_execute();
      $view->execute();
      $view_markup = $view->render();

      $modal_markup = <<<EOL
<div class="modal fade" id="member-modal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title">Netværkets medlemmer</h4>
      </div>
      <div class="modal-body">
        $view_markup
      </div>
    </div>
  </div>
</div>
EOL;

      $block['content'] = $modal_markup;
      break;

    case 'group-not-member-message':
      if (arg(0) == 'node' && is_numeric(arg(1))) {
        $gid = arg(1);
        if ($gid && !og_is_member('node', $gid)) {
          $state = ktc_netvaerk_group_state($gid);
          $message = ktc_netvaerk_state_message($state);
          $block['content'] = $message;
        }
      }
      break;
  }
  return $block;
}

/**
 * Get netvaerk openess.
 */
function ktc_netvaerk_group_state($gid) {
  $group_node = node_load($gid);

  $open = 0;
  $access = 0;

  if ($field = field_get_items('node', $group_node, 'field_open_group')) {
    $open = $field[0]['value'];
  }
  if ($field = field_get_items('node', $group_node, 'group_content_access')) {
    $access = $field[0]['value'];
  }

  if ($open) {
    return KTC_NETVAERK_GROUP_OPEN;
  }
  else {
    if ($access == 1) {
      return KTC_NETVAERK_GROUP_CLOSED_VISIBLE;
    }
    else {
      return KTC_NETVAERK_GROUP_CLOSED_HIDDEN;
    }
  }
}

/**
 * Get message for given state.
 */
function ktc_netvaerk_state_message($state) {
  return variable_get('ktc_netvaerk_state_message-' . $state);
}

/**
 * KTC netvaerk get node group info.
 */
function ktc_netvaerk_get_node_group_info($nid) {
  $group_info = array('name' => '', 'class' => '', 'gid' => '');
  if (is_numeric($nid)) {
    $node = node_load($nid);
    if ($gid = field_get_items('node', $node, 'og_group_ref')) {
      $gid = $gid[0]['target_id'];
      $group = node_load($gid);
      $class = ktc_netvaerk_check_my_groups($gid);
      // TODO: get class green for some specific group type.
      /*$tid = '';
      if ($group_type = field_get_items('node', $group, 'field_netvaerkstype')){
      $tid = $group_type[0]['tid'];

      }*/
      $group_info = array(
        'name' => $group->title,
        'class' => $class,
        'gid' => $gid,
      );
    }

    // If the node type is a group.
    if ($node->type == 'group') {
      // Check user is a member or not.
      $class = ktc_netvaerk_check_my_groups($nid);
      $group_info = array(
        'name' => $node->title,
        'class' => $class,
        'gid' => $gid,
      );
      // TODO: the forengingen(green).
    }
    // If node type is magazine, so there is no group,
    // return class is blue.
    if ($node->type == 'magazine') {
      $group_info = array('name' => 'magazine', 'class' => 'ktc-blue');
    }
  }
  return $group_info;

}
/**
 * Check group, add classes.
 */
function ktc_netvaerk_check_my_groups($nid) {
  // Yellow is the genernal group.
  $class = 'ktc-yellow';

  if ($gids = og_get_groups_by_user()) {
    if (in_array($nid, $gids['node'])) {
      // Red is my group.
      $class = 'ktc-red';
    }
  }

  // Check group content visibility.
  $node = node_load($nid);
  if ($visible = field_get_items('node', $node, 'og_roles_permissions')) {
    if ($visible[0]['value']) {
      $class .= ' private-content';
    }
  }
  return $class;
}

/**
 * Implements hook_node_insert().
 */
function ktc_netvaerk_node_insert($node) {
  if ($node->type == 'group') {
    $old_uid = $node->uid;
    // Auto add user membership.
    $account = user_load($old_uid);
    // Add the user to the group.
    og_group('node', $node->nid, array(
                "entity type"       => "user",
                "entity"        => $account,
                "membership type"   => OG_MEMBERSHIP_TYPE_DEFAULT,
            ));
    // Changes the users role in the group
    // (1 = non-member, 2 = member, 3 = administrator member).
    og_role_grant('node', $node->nid, $account->uid, 3);

    // Update node: add global owner to group.
    ktc_netvaerk_change_own($node);
  }
}

/**
 * Chang group owner.
 */
function ktc_netvaerk_change_own($node) {
  if ($node->type == 'group') {
    $name = variable_get('group_owner', 'netvaerk@ktc.dk');
    $owner = user_load_by_name($name);

    db_update('node')->fields(array('uid' => $owner->uid))->condition('nid', $node->nid)->execute();
  }
}
/**
 * Get group content types.
 */
function ktc_netvaerk_get_group_content_types($nid = 'all') {
  $types = array();
  if (is_numeric($nid)) {
    $query = db_select('og_membership', 'ogm');
    $query->join('node', 'n', 'n.nid = ogm.etid');
    $query->distinct()
          ->fields('n', array('type'))
          ->condition('ogm.gid', $nid, '=')
          ->condition('ogm.entity_type', 'node', '=');
    $result = $query->execute();
    if ($result->rowCount() > 0) {
      while ($record = $result->fetchAssoc()) {
        if ($record['type'] == 'group') {
          continue;
        }
        $types[] = $record['type'];
      }
    }
  }
  if ($nid == 'all') {
    $node_types = node_type_get_types();
    foreach ($node_types as $obj) {
      // Skip hearing_responses type.
      if ($obj->type == 'hearing_responses' || $obj->type == 'group') {
        continue;
      }
      if (og_is_group_content_type('node', $obj->type)) {
        $types[] = $obj->type;
      }
    }
  }
  return $types;
}

/**
 * Implements hook_node_validate().
 */
function ktc_netvaerk_node_validate($node, $form, &$form_state) {

  if ($node->type == 'group') {
    // Get users groups.
    $gids = og_get_groups_by_user();

    // Check if user has 'create top group' permission.
    $create_top_group = user_access('create ktc top group');
    // Top group field.
    $og_group_ref = isset($form_state['values']['og_group_ref']) ? $form_state['values']['og_group_ref'] : FALSE;
    if (!$create_top_group) {
      // If the user cannot create top group,
      // so the og_group_ref field cannot be empty.
      if (!$og_group_ref) {
        form_set_error('og_group_ref', t('Du skal vælge et overstående netværk.'));
      }
      if (isset($og_group_ref['und'][0]['target_id'])) {
        // Check if user is a member of the chosen group.
        if (!in_array($og_group_ref['und'][0]['target_id'], $gids['node'])) {
          form_set_error('og_group_ref', t('Du er ikke medlem af det netværk.'));
        }
      }
      else {
        form_set_error('og_group_ref', t('Du skal vælge et overstående netværk.'));
      }
    }
  }
}

/**
 * Implements hook_node_presave().
 */
function ktc_netvaerk_node_presave($node) {
  if ($node->type == 'group') {
    if ($parent_group = field_get_items('node', $node, 'og_group_ref')) {

      // Get subgroup's members.
      $query = new EntityFieldQuery();
      $query->entityCondition('entity_type', 'user')
        ->fieldCondition('og_user_node', 'target_id', $node->nid, '=');

      $results = $query->execute();

      $uids = isset($results['user']) ? array_keys($results['user']) : array();
      if (!empty($uids)) {
        foreach ($uids as $uid) {
          $account = user_load($uid);
          // Add the user to the parent group.
          og_group('node', $parent_group[0]['target_id'], array(
                      "entity type"       => "user",
                      "entity"        => $account,
                      "membership type"   => OG_MEMBERSHIP_TYPE_DEFAULT,
                  ));
          // Changes the users role in the group
          // (1 = non-member, 2 = member, 3 = administrator member).
          og_role_grant('node', $parent_group[0]['target_id'], $uid, 2);
        }
        // Loop for all the top groups.
        $parent_obj = node_load($parent_group[0]['target_id']);
        node_save($parent_obj);
      }
    }
  }
}

/**
 * Implements hook_permission().
 */
function ktc_netvaerk_permission() {
  return array(
    'create ktc top group' => array(
      'title' => t('Opret ktc top netværk'),
      'description' => t('Opret ktc top netværk som ktc admin.'),
    ),
  );
}

/**
 * Implements hook_menu_alter().
 */
function ktc_netvaerk_menu_alter(&$items) {
  // Change theme these pages.
  $items['node/add/group']['theme callback'] = 'ktc_netvaerk_get_default_theme';
  $items['group/%/%/admin/people/invite-users']['theme callback'] = 'ktc_netvaerk_get_default_theme';
  $items['node/%/group']['theme callback'] = 'ktc_netvaerk_get_default_theme';
  $items['group/%/%/admin/people/add-user']['theme callback'] = 'ktc_netvaerk_get_default_theme';
}
/**
 * Get default theme callback.
 */
function ktc_netvaerk_get_default_theme() {
  return variable_get('theme_default', '0');
}

/**
 * Implements hook_theme().
 */
function ktc_netvaerk_theme($existing, $type, $theme, $path) {
  $path = 'theme/';
  return array(
    'ktc_netvaerk_invite_form' => array(
      'render element' => 'form',
      'template' => $path . 'ktc-netvaerk-invite-form',
    ),
  );
}
/**
 * Implements hook_form_alter().
 */
function ktc_netvaerk_form_alter(&$form, $form_state, $form_id) {
  if ($form_id == 'group_node_form' && isset($form_state['entityreference_prepopulate'])) {
    drupal_set_title('Opret Undernetværk');
  }
}
