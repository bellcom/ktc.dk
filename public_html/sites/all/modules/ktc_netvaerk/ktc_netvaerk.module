<?php
/**
 * @file
 * Code for the KTC netværk feature.
 */

// Status of an open group.
define('KTC_NETVAERK_GROUP_OPEN', 1);
// Status of a closed group with visible content.
define('KTC_NETVAERK_GROUP_CLOSED_VISIBLE', 2);
// Status of a closed group with hidden content.
define('KTC_NETVAERK_GROUP_CLOSED_HIDDEN', 3);

// Grouprole tid for group member.
define('KTC_NETVAERK_MEMBER_TID', variable_get('ktc_netvaerk_member_tid'));
// Grouprole tid for group administrator.
define('KTC_NETVAERK_ADMIN_TID', variable_get('ktc_netvaerk_admin_tid'));

include_once 'ktc_netvaerk.features.inc';

/**
 * Implements hook_menu().
 */
function ktc_netvaerk_menu() {
  $items['admin/netvaerk_setting'] = array(
    'type' => MENU_NORMAL_ITEM,
    'title' => 'Netværk settings',
    'description' => 'Configure group settings',
    'page callback' => 'drupal_get_form',
    'page arguments' => array('ktc_netvaerk_settings'),
    'access arguments' => array('access administration pages'),
  );
  $items['netvaerk/form/%/%/%'] = array(
    'page callback' => 'ktc_netvaerk_get_form',
    'page arguments' => array(2, 3, 4),
    'access callback' => 'og_user_access',
    'access arguments' => array('node', 2, 'administer group'),
  );
  $items['netvaerk/emner/%/%/%'] = array(
    'access callback'   => true,
    'page callback'     => 'ktc_netvaek_get_emner',
    'page arguments' => array(2, 3, 4),
    'delivery callback' => 'drupal_json_output' 
  );
  return $items;
}

function ktc_netvaek_get_emner($content_type, $network_type, $region) {
  $content_types = explode(',', $content_type);
  $regions = explode(',', $region);

  $query = new EntityFieldQuery();

  $query->entityCondition('entity_type', 'node')
    ->entityCondition('bundle', 'group');
  if (!empty($regions) && $regions[0] != 'all') {
    $query->fieldCondition('field_regioner', 'tid', $regions, 'IN');
  }
  $result = $query->execute();

  if (isset($result['node'])) {
    $nids = array_keys($result['node']);

    $db_or = db_or(); 
    foreach($nids as $nid){
	 $db_or->condition('ogm.gid', $nid, '=');
    }

    $query = db_select('og_membership', 'ogm');
    $query->join('node', 'n', 'n.nid = ogm.etid');
    $query->join('field_data_field_topics', 'f', 'f.entity_id = ogm.etid');
    $query->join('taxonomy_term_hierarchy', 'tth', 'tth.tid = f.field_topics_tid');
    $query->distinct()
          ->fields('f', array('entity_id', 'field_topics_tid'))
	  ->condition($db_or)
          ->condition('ogm.entity_type', 'node', '=')
	  ->condition('tth.parent', '0', '=');
    
    if (!empty($content_types) && $content_types[0] != 'all') {
      $query->condition('n.type', $content_types, 'IN');
    }

    $result = $query->execute();

    $emner = array();
    if ($result->rowCount() > 0) {
      while ($record = $result->fetchAssoc()) {
        $emner[$record['entity_id']] = intval($record['entity_id']);
      }
    }

    return $emner;
  }  

  return array();
}

/**
 * Return form form embedding in group modal.
 */
function ktc_netvaerk_get_form($gid, $action, $membership_id) {
  $og_membership = FALSE;
  if ($membership_id) {
    $og_membership = og_membership_load($membership_id);
  }
  $actions = array(
    'add-user' => 'og_ui_add_users',
    'edit-membership' => 'og_ui_edit_membership',
    'delete-membership' => 'og_ui_delete_membership',
    'approve-membership' => 'ktc_netvaerk_approve_membership',
  );

  $form = $actions[$action];
  module_load_include('inc', 'og_ui', 'og_ui.admin');
  $form = drupal_get_form($form, 'node', $gid, $og_membership);
  // Hide request message.
  $form['membership_fields']['og_membership_request']['#access'] = FALSE;
  $form['og_user']['state']['#access'] = FALSE;

  if (isset($form['actions']) && isset($form['actions']['delete'])) {
    $form['actions']['delete']['#access'] = FALSE;
  }

  die(drupal_render($form));
}

/**
 * Aprove membership request.
 */
function ktc_netvaerk_approve_membership($form, &$form_state, $group_type, $gid, $og_membership) {
  $group = entity_load_single($group_type, $gid);
  $label = entity_label($group_type, $group);
  $account = user_load($og_membership->etid);

  $form_state['og_membership'] = $og_membership;

  return confirm_form($form,
    t('Godkend ansøgning om medlemskab i @group', array('@group' => $label)),
    $group_type . '/' . $gid,
    t('Er du sikker på at du vil godkende medlemskabet for @user', array('@user' => $account->name)),
    t('Godkend'),
    t('Cancel')
  );
}

/**
 * Submit handler; Approve membership request.
 */
function ktc_netvaerk_approve_membership_submit($form, &$form_state) {
  $og_membership = $form_state['og_membership'];
  $og_membership->state = 1;

  og_membership_save($og_membership);
  drupal_set_message(t('Medlemsskabet er blevet godkendt.'));
}


/**
 * KTC netvaerk setting form.
 */
function ktc_netvaerk_settings() {
  $form = array();

  $form['group_owner'] = array(
    '#type' => 'textfield',
    '#title' => t('Grupper ejer'),
    '#description' => t('Global grupper ejer'),
    '#size' => 30,
    '#default_value' => variable_get('group_owner', ''),
    '#autocomplete_path' => 'user/autocomplete',
  );

  $form['netvaerk_not_member'] = array(
    '#title' => t('Beskeder til brugere der ikke er medlem af netværket'),
    '#type' => 'fieldset',
  );

  $var_name = 'ktc_netvaerk_state_message-' . KTC_NETVAERK_GROUP_OPEN;
  $form['netvaerk_not_member'][$var_name] = array(
    '#type' => 'textarea',
    '#title' => t('Besked på åbent netværk'),
    '#default_value' => variable_get($var_name),
  );

  $var_name = 'ktc_netvaerk_state_message-' . KTC_NETVAERK_GROUP_CLOSED_VISIBLE;
  $form['netvaerk_not_member'][$var_name] = array(
    '#type' => 'textarea',
    '#title' => t('Besked på (lukket)netværk hvor indholdet er synligt'),
    '#default_value' => variable_get($var_name),
  );

  $var_name = 'ktc_netvaerk_state_message-' . KTC_NETVAERK_GROUP_CLOSED_HIDDEN;
  $form['netvaerk_not_member'][$var_name] = array(
    '#type' => 'textarea',
    '#title' => t('Besked på (lukket)netværk hvor indholdet er skjult'),
    '#default_value' => variable_get($var_name),
  );
  $var_name = 'ktc_netvaerk_state_message-' . KTC_NETVAERK_GROUP_CLOSED_HIDDEN;
  $form['netvaerk_not_member']['ktc_netvaerk_search_empty_message'] = array(
    '#type' => 'textarea',
    '#title' => t('Besked på (lukket)netværk hvor indholdet er skjult'),
    '#default_value' => variable_get($var_name),
  );

  $group_types_vocab = taxonomy_vocabulary_machine_name_load('netv_rkstype');
  $group_types = taxonomy_term_load_multiple(array(), array('vid' => $group_types_vocab->vid));

  foreach ($group_types as $group_type) {
    $group_types_options[$group_type->tid] = $group_type->name;
  }
 $form['ktc_netvaerk_search_empty_message'] = array(
    '#type' => 'textarea',
    '#title' => t('Text which shown if filter / search result is empty'),
    '#default_value' => variable_get('ktc_netvaerk_search_empty_message', 'No result'),
  );
  $form['ktc_netvaerk_type_closed'] = array(
    '#type' => 'checkboxes',
    '#title' => t('Håndter netværk som "Lukket"'),
    '#suffix' => t('Netværket vil altid blive gemt som "Lukket" og det vil ydermere ikke være muligt at tilmelde sig netværket som bruger.'),
    '#options' => $group_types_options,
    '#default_value' => variable_get('ktc_netvaerk_type_closed'),
  );

  $grouproles_vocab = taxonomy_vocabulary_machine_name_load('ktc_netvaerk_grouproles');
  $grouproles = taxonomy_term_load_multiple(array(), array('vid' => $grouproles_vocab->vid));

  foreach ($grouproles as $grouprole) {
    $grouproles_options[$grouprole->tid] = $grouprole->name;
  }

  $form['ktc_netvaerk_admin_tid'] = array(
    '#type' => 'select',
    '#title' => t('Netværksadministrator grupperolle'),
    '#options' => $grouproles_options,
    '#default_value' => variable_get('ktc_netvaerk_admin_tid'),
  );

  $form['ktc_netvaerk_member_tid'] = array(
    '#type' => 'select',
    '#title' => t('Netværksmedlem grupperolle'),
    '#options' => $grouproles_options,
    '#default_value' => variable_get('ktc_netvaerk_member_tid'),
  );

  return system_settings_form($form);
}

/**
 * Implements hook_og_user_access_alter().
 */
function ktc_netvaerk_og_user_access_alter(&$perm, $context) {
  // We handle if the group is open/closed.
  // @see ktc_netvaerk_settings()
  if ($context['group_type'] == 'node') {
    $group = $context['group'];

    if (is_object($group)) {
      // If the group is of the same type as the specified closed
      // ones. Don't allow the user to subscribe.
      if ($field = field_get_items('node', $group, 'field_netvaerkstype')) {
        $type_closed = variable_get('ktc_netvaerk_type_closed', array());

        if (in_array($field[0]['tid'], array_values($type_closed))) {
          // The closed groups are only supposed to be handled from CRM.
          $perm['subscribe'] = FALSE;
          $perm['invite any user'] = FALSE;
          $perm['administer group'] = FALSE;
          $perm['add user'] = FALSE;
          $perm['unsubscribe'] = FALSE;
          $perm['manage members'] = FALSE;
        }
      }

      // If the group is "open" allow users to subscribe without approval.
      if ($field = field_get_items('node', $group, 'field_netvaerkstype')) {
        if ($field[0]['value']) {
          $perm['subscribe without approval'] = TRUE;
        }
      }
    }
  }
}

/**
 * Implements hook_token_info().
 */
function ktc_netvaerk_token_info() {
  $info['tokens']['node']['ktc-netvaerk-url'] = array(
    'name' => t('OG Group-url'),
    'description' => t('URL for og group reference.'),
  );

  $info['tokens']['node']['ktc-content'] = array(
    'name' => t('Indhold'),
    'description' => t('Indholdet af noden'),
  );
  return $info;
}

/**
 * Implements hook_tokens().
 */
function ktc_netvaerk_tokens($type, $tokens, array $data = array(), array $options = array()) {
  $replacements = array();
  $sanitize = !empty($options['sanitize']);

  if ($type == 'node' && !empty($data['node'])) {
    $node = $data['node'];

    foreach ($tokens as $name => $original) {
      switch ($name) {
        case 'ktc-netvaerk-url':
          if ($field = field_get_items('node', $node, 'og_group_ref')) {
            $options = array('absolute' => TRUE);
            $replacements[$original] = url('node/' . reset($field)['target_id'], $options);
          }
          break;

        case 'ktc-content':
          $replacements[$original] = '';

          if ($field = field_get_items('node', $node, 'body')) {
            if ($field[0]['summary']) {
              $replacements[$original] = $field[0]['safe_summary'];
            }
            else {
              $replacements[$original] = text_summary($field[0]['safe_value']);
            }
          }
          break;
      }
    }
  }

  return $replacements;
}

/**
 * Implements hook_block_info().
 */
function ktc_netvaerk_block_info() {
  $blocks['sidebar-group-members'] = array(
    'info' => t('KTC Netværk, Gruppe medlemmer - sidebar'),
  );

  $blocks['sidebar-group-admins'] = array(
    'info' => t('KTC Netværk, Gruppe administratorer - sidebar'),
  );

  $blocks['group-members'] = array(
    'info' => t('KTC Netværk, Gruppe medlemmer modal'),
  );

  $blocks['group-not-member-message'] = array(
    'info' => t('KTC Netværk, Besked til besøgende der ikke er medlem af netværket'),
