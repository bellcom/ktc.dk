define('KTC_HEARING_STATUS_RECAP', variable_get('ktc_hearing_status_recap', 1838));
define('KTC_HEARING_STATUS_APPROVAL', variable_get('ktc_hearing_status_approval', 1839));
define('KTC_HEARING_STATUS_APPROVED', variable_get('ktc_hearing_status_approved', 1840));
define('KTC_HEARING_STATUS_CLOSED', variable_get('ktc_hearing_status_closed', 1892));
define('KTC_HEARING_STATUS_KL_ANSWER', variable_get('ktc_hearing_status_kl_answer', 1892));

/**
 * Implements hook_views_pre_render().
 * @param $view
 */
function ktc_hearing_views_pre_render(&$view) {

  if (($view->name == "indhold_m_filter" && ($view->current_display == 'panel_pane_4' or $view->current_display == 'panel_pane_5'))) {

    foreach ($view->result as $key => $result) {
      $node = node_load($result->nid);

      if (!node_access('view', $node)) {
        unset($view->result[$key]);
      }
    }

    $current_items = $view->query->pager->total_items;
    $total = $current_items - count($view->result);

    $view->query->pager->total_items = $total;
    $view->query->pager->update_page_info();
  }
}

