/**
 * Implements hook_form_alter().
 */
function ktc_hearing_form_alter(&$form, &$form_state, $form_id) {
  // Don't redirect hearing response node form submits.
  if ($form_id != 'hearing_node_form' && strstr($form_id, '_node_form') && strstr($form_id, 'hearing')) {
    $form['actions']['submit']['#submit'][] = '_ktc_hearing_redirect_to_hearing';
    $form['actions']['draft']['#submit'][] = '_ktc_hearing_redirect_to_hearing';
  }

  // On the hearing node form. It should only be possible to select a
  // 'faggruppe' in the og_group_ref field.
  if ($form_id == 'hearing_node_form') {
    global $user;
    $group_ids = _ktc_hearing_user_can_create_hearing_groups($user->uid);
    // Filter them out of the normal options. Preserve preselected groups.
    foreach ($form['og_group_ref'][LANGUAGE_NONE]['#options'] as $nid => &$option) {
      if (!in_array($nid, $group_ids) && !in_array($nid, $form['og_group_ref'][LANGUAGE_NONE]['#default_value'])) {
        unset($form['og_group_ref'][LANGUAGE_NONE]['#options'][$nid]);
        continue;
      }
      $option = decode_entities($option);
    }
    $form['#validate'][] = 'ktc_hearing_form_validate';
    $form['#after_build'][] = 'ktc_hearing_form_after_build';
    $form['#suffix'] = '<div id="confirm" title="Bekr�ft datoer"></div>';
  }
}
/**
 * Implements hook_form_after_build().
 */
function ktc_hearing_form_after_build($form, &$form_state) {
  drupal_add_js(drupal_get_path('module', 'ktc_hearing') . '/ktc_hearing_node_submit.js');
    return $form;
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function ktc_hearing_form_hearing_responses_node_form_alter(&$form, &$form_state, $form_id) {
  // Don't process the entire form and don't use cache if this was an ajax
  // request. This will break the prefilled fields.
  if (!empty($form_state['triggering_element']['#ajax'])) {
    $form_state['no_cache'] = TRUE;
    return;
  }

  // Change the way the form for hearing responses behave on the response page.
  $form['#hearing_id'] = arg(1);
  // Prefill title.
  global $user;
  $user = user_load($user->uid);
  $user_name = $user->name;

  if ($name_field = field_get_items('user', $user, 'field_navn')) {
    $user_name = $name_field[0]['value'];
  }

  $form['title']['#default_value'] = t('Høringssvar') . ': ' . $user_name;

  // Add reference to the hearing.
  $language = $form['field_hearing_node']['#language'];
  if (!$form['field_hearing_node'][$language][0]['target_id']['#default_value']) {
    $form['field_hearing_node'][$language][0]['target_id']['#default_value'] = arg(1);
    unset($form['field_hearing_node'][$language][0]['target_id']['#element_validate']);
  }

  $form['field_is_no_answer']['#access'] = 0;

  // These two steps, allows the user to move the hearing foward in the
  // workflow. To ease the process. An extra submit button is added.
  switch (arg(2)) {
    case 'summary_hearing_response':
      $language = $form['field_is_summary']['#language'];
      $form['field_is_summary'][$language]['#default_value'] = 1;
      $form['title']['#default_value'] = t('Endeligt høringssvar') . ': ' . $user_name;

      $form['actions']['send_for_approval'] = array(
        '#type' => 'submit',
        '#value' => t('Gem og send til godkendelse'),
        '#weight' => 50,
      );
      // Execute all normal submit callbacks.
      $form['actions']['send_for_approval']['#submit'] = $form['actions']['submit']['#submit'];
      // And update the status for the node.
      $form['actions']['send_for_approval']['#submit'][] = 'ktc_hearing_set_status_approval';
      break;

    case 'approve_summary_hearing_response':
      $form['actions']['set_approved'] = array(
        '#type' => 'submit',
        '#value' => t('Gem og godkend'),
        '#weight' => 50,
      );
      // Execute all normal submit callbacks.
      $form['actions']['set_approved']['#submit'] = $form['actions']['submit']['#submit'];
      // And update the status for the node.
      $form['actions']['set_approved']['#submit'][] = 'ktc_hearing_set_status_approved';
      break;
  }

  // Hide fields.
  $form['title']['#access'] = 0;
  $form['field_hearing_node']['#access'] = 0;
  $form['field_typo3_uid']['#access'] = 0;
  $form['field_is_final']['#access'] = 0;
  $form['field_is_summary']['#access'] = 0;
  $form['field_typo3_user_id']['#access'] = 0;
  $form['group_content_access']['#access'] = 0;
  $form['field_hearing_response_type']['#access'] = 0;
  $form['og_group_ref']['#access'] = 0;
  $form['options']['#access'] = 0;
  $form['revision_information']['#access'] = 0;
  $form['actions']['preview_changes']['#access'] = 0;
}

/**
 * Implements hook_form_validate().
 */
function ktc_hearing_form_validate($form, &$form_state) {
 $official_date = strtotime($form_state['values']['field_official_date']['und'][0]['value']);
 $official_responsedate = strtotime($form_state['values']['field_official_responsedate']['und'][0]['value']);
 $attendee_deadlines = strtotime($form_state['values']['field_attendee_deadlines']['und'][0]['value']);
 $enrollment_deadlines = strtotime($form_state['values']['field_enrollment_deadlines']['und'][0]['value']);

 if ($official_date > $official_responsedate || $official_date > $attendee_deadlines || $official_date > $enrollment_deadlines)
   form_set_error ('field_official_date', t("Den officielle udsendelsesdato skal opsættes til at være tidligere end alle andre datoer i høringen"));

 if ($official_responsedate < $$official_date || $official_responsedate < $attendee_deadlines || $official_responsedate < $enrollment_deadlines)
   form_set_error ('field_official_responsedate', t("Den officielle svardato skal opsættes til at være senere end alle andre datoer i høringen"));
}

/**
 * Implements hook_mail().
 */
function ktc_hearing_mail($key, &$message, $params) {
  $message['subject'] = $params['subject'];
  $message['body'][] = $params['body'];
}

/**
 * Implements hook_node_access().
 */
function ktc_hearing_node_access($node, $op, $account) {
  if (is_object($node)) {
    if ($node->uid == $account->uid) {
      return NODE_ACCESS_ALLOW;
    }

    // Determine if it's a hearing.
    if ($node->type == 'hearing') {
      $hearing = $node;

      $access = ktc_hearing_user_has_access($hearing, $account);

      if (in_array($op, $access)) {
        return NODE_ACCESS_ALLOW;
      }

      // This is a hearing, if no other access is returned, deny.
      return NODE_ACCESS_DENY;
    }

    if ($node->type == 'hearing_responses') {
      if ($hearing = _ktc_hearing_get_hearing_from_response($node)) {
        $access = ktc_hearing_user_has_access($hearing, $account);

        if ($op == 'view' && in_array($op, $access)) {
          return NODE_ACCESS_ALLOW;
        }

        return NODE_ACCESS_DENY;
      }
    }
  }

  // Determine who has permissions to create hearings.
  if (is_string($node) && $node == 'hearing') {
    if ($op == 'create') {
      if (_ktc_hearing_user_can_create_hearing($account)) {
        return NODE_ACCESS_ALLOW;
      }
      else {
        return NODE_ACCESS_DENY;
      }
    }
  }
}

