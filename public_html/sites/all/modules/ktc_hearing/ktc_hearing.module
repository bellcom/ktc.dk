}

/**
 * Implements hook_block_view().
 */
function ktc_hearing_block_view($delta = '') {
  $block = array();

  switch ($delta) {
    case 'ktc_hearing_unresponded':
      $vars['unresponded_hearings'] = _ktc_hearing_get_unresponded();

      $block['subject'] = t('Dine høringer der mangler svar');
      $block['content'] = theme('block_hearing_unresponded', $vars);
      break;

    case 'ktc_hearing_unresponded_section':
      $vars['unresponded_hearings'] = _ktc_hearing_get_unresponded();

      $block['subject'] = t('Dine høringer der mangler svar');
      $block['content'] = theme('block_hearing_unresponded_sectionpage', $vars);
      break;

    case 'ktc_hearing_set_status_form':
      if ($hearing = node_load(arg(1))) {
        $status = ktc_hearing_get_status($hearing);
        if ($status != KTC_HEARING_STATUS_APPROVED && ktc_hearing_access($hearing, 'update')) {
          $block['content'] = drupal_get_form('ktc_hearing_set_status');
        }
      }
      break;

    case 'ktc_hearing_info_block':
      $vars = _ktc_hearing_get_info_vars();

      $block['content'] = theme('block_hearing_info', $vars);
      break;
  }
  return $block;
}

/**
 * @param bool|FALSE $uid
 *
 * @return array
 */
function _ktc_hearing_get_hearing_nids_by_user_id($user) {
  $nids = array();

  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'node')
    ->entityCondition('bundle', 'hearing');
  $result = $query->execute();

  if (isset($result['node'])) {

    foreach (node_load_multiple(array_keys($result['node'])) as $hearing) {

      if (ktc_hearing_user_has_access($hearing, $user)) {
        $nids[] = $hearing->nid;
      }
    }
  }

  return $nids;
}

/**
 * Implements views_pre_view().
 */
function ktc_hearing_views_pre_view(&$view, &$display_id, &$args) {
  // Set the arguments for the sectionpage block.
  if ($view->name == 'ktc_hearings_sectionpage_block') {
    $hearings = implode(',', array_values(_ktc_hearing_get_unresponded_nids()));
    $view->args = array($hearings);
  }
}

/**
 * Implements hook_file_download().
 */
function ktc_hearing_file_download($uri) {
  // Here we determine if the file is attached to a hearing, and in this case
  // wether the user is allowed to view this hearing.
  // If not, we tell drupal not to let the user download it.
  // Our starting point is that the user is allowed to watch the file. We do it
  // this way, since all private files are passed throug here for access
  // checking.
  $access = TRUE;

  // Find file usage.
  $result = db_query('SELECT f.fid
                FROM {file_managed} f WHERE f.uri = :uri', array(':uri' => $uri))->fetchAll();

  if ($result) {
    $file = file_load($result[0]->fid);
    $usage = file_usage_list($file);

    if ($usage['file']['node']) {
      foreach ($usage['file']['node'] as $nid => $count) {
        $node = node_load($nid);

        if ($node->type == 'hearing') {
          if (ktc_hearing_access($node, 'view')) {
            $access = TRUE;
            continue;
          }
          else {
            $access = FALSE;
          }
        }
      }
    }
  }

  // If access is granted, let drupal (or other hooks) handle the permissions.
  if ($access) {
    return NULL;
  }
  // If access is denied to the hearing, tell drupal not to let the user download the
  // file.
  else {
    return FALSE;
  }
}

/**
 * Access callback function.
 */
function ktc_hearing_access($node, $op) {
  $status = ktc_hearing_get_status($node);

  $disable_on_closed = array(
    'approve summary response',
    'invite',
    'summary response',
    'view responses',
    'view summary response',
  );

  if (in_array($op, $disable_on_closed) && $status == KTC_HEARING_STATUS_APPROVED) {
    return FALSE;
  }

  if ($node->type != 'hearing') {
    return FALSE;
  }

  global $user;
  if ($user->uid == 1) {
    return TRUE;
  }

  // If the user has declined to respond to the hearing. Don't allow access to
  // the decline response page again.
  if ($op == 'dont respond' && $response_nid = ktc_hearing_user_has_responded($node)) {
    if ($response = node_load($response_nid)) {
      return FALSE;
    }
  }

  global $user;
  $access = ktc_hearing_user_has_access($node, $user);

  if (in_array($op, $access)) {
    return TRUE;
  }

  // Catch all.
  return FALSE;
}

/**
 * KTC hearing invite page callback.
 */
function ktc_hearing_invite_page($nid) {
  $invite_form = drupal_get_form('ktc_hearing_invite', $nid);

  $vars['preface'] = render($invite_form);

  return theme('hearing_answer', $vars);
}

/**
 * Invite user to hearing, form.
 */
function ktc_hearing_invite($form, $form_state, $hearing) {
  $form = array();
  $form['hearing_nid'] = array(
    '#type' => 'hidden',
    '#value' => $hearing->nid,
  );

  $form['user'] = array(
    '#type' => 'textfield',
    '#title' => t('Invite'),
    '#description' => t('Here you can invite another user to attend the hearing.'),
    '#size' => 30,
    '#autocomplete_path' => 'user/autocomplete',
  );

  $form['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Send invitation'),
  );

  return $form;
}

/**
 * Invite user to user, submit handler.
 */
function ktc_hearing_invite_submit(&$form, &$form_state) {
  if ($node = node_load($form_state['values']['hearing_nid'])) {
    if ($user = user_load_by_name($form_state['values']['user'])) {
      $wrapper = entity_metadata_wrapper('node', $node);

      if (in_array($user->uid, $wrapper->field_attendees->raw())) {
        drupal_set_message(t('The user is already an attendee on the hearing'), 'warning');
        return;
      }

      $wrapper->field_attendees[] = $user->uid;

      $wrapper->save();
      drupal_set_message(t('The user user has been added to the hearing.'));
      ktc_hearing_notifications_notify_attendee($user->uid, $node);
    }
  }
}

/**
 * Hearing summary response page.
 */
function ktc_hearing_summary_responses($hearing) {
  if (ktc_hearing_get_status($hearing) == KTC_HEARING_STATUS_OPEN) {
    $vars['preface'] = 'Ønsker du at starte sammenskrivning skal du ændre status til "Under sammenskrivning" i blokken til højre.';
  }

  elseif (ktc_hearing_get_status($hearing) == KTC_HEARING_STATUS_RECAP) {
    module_load_include('inc', 'node', 'node.pages');

    $query = new EntityFieldQuery();
    $query->entityCondition('entity_type', 'node')
      ->propertyCondition('status', 1)
      ->entityCondition('bundle', 'hearing_responses')
      ->fieldCondition('field_hearing_node', 'target_id', $hearing->nid);
    $result = $query->execute();

    if (isset($result['node'])) {
      foreach ($result['node'] as $item) {
        $node = node_load($item->nid);

        if (_ktc_hearing_response_is_summary($node)) {
          continue;
        }

        $vars['responses'][] = node_view($node, 'teaser');
      }
    }

    $type = 'hearing_responses';

    global $user;
    $node = (object) array(
      'uid' => $user->uid,
      'name' => (isset($user->name) ? $user->name : ''),
      'type' => $type,
      'language' => LANGUAGE_NONE,
    );

    if ($summary_response = ktc_hearing_get_summary_response($hearing)) {
      $node = $summary_response;
    }

    $vars['answer_form'] = render(drupal_get_form($type . '_node_form', $node));

  }
  else {
    $vars['preface'] = 'Høringens status tillader ikke sammenskrivning af høringssvar.';
  }

  drupal_set_title('Skriv sammenfatning: ' . drupal_get_title());
  return theme('hearing_answer', $vars);
}

/**
 * Page callback for viewing hearing response.
 */
function ktc_hearing_view_summary_responses($hearing) {
  if ($summary_response = ktc_hearing_get_summary_response($hearing)) {
    if (ktc_hearing_get_status($hearing) == KTC_HEARING_STATUS_APPROVED) {

      $vars['preface'] = '<span class="hearing-pdf-link">' . l(t('Hent pdf-udgave'), 'node/' . $hearing->nid . '/hearing_summary_answer_pdf') . '</span>';
      $vars['preface'] .= render(node_view($summary_response));
    }
  }
  else {
    $vars['preface'] = 'Der er endnu ikke skrevet og godkendt sammenfatning på denne høring.';
  }

  return theme('hearing_answer', $vars);
}

/**
 * Implements hook_node_load().
 */
function ktc_hearing_node_load($nodes, $types) {
  if (count($nodes) != 1) {
    return;
  }

  $node = reset($nodes);
  // Redirect to the appropriate page on the hearing if a response is loaded.
  // Viewing the node normally doesn't fit the flow of the hearing process.
  if ($types[0] == 'hearing_responses' && arg(1) == $node->nid && arg(2) != 'delete') {
    unset($_GET['destination']);
    if ($hearing = ktc_hearing_get_hearing_from_response($node)) {
      if (ktc_hearing_access($hearing, 'view responses')) {
        drupal_goto('node/' . $hearing->nid . '/hearing_response');
      }
      drupal_goto('node/' . $hearing->nid);
    }
  }
}

/**
 * Implements hook_node_view().
 */
function ktc_hearing_node_view($node, $view_mode) {
  if ($node->type == 'hearing_responses' && $view_mode == 'full') {
    $hearing = ktc_hearing_get_hearing_from_response($node);

    if ($field = field_get_items('node', $hearing, 'field_link_kl_hoeringssvar')) {
      // Show link.
      $node->content['kl_hearing_answer_link'] = array(
        '#markup' => '<a href="' . $field[0]['url'] . '">Link til KL høringssvar</a>',
        '#weight' => -10,
      );
    }
    else {
      // Show form to enter KL answer url, if the user has the sufficient
      // permissions.
      $access = ktc_hearing_user_has_access($hearing, $account);
      if (in_array('link to kl answer', $access)) {
        $node->content['kl_hearing_answer_form'] = drupal_get_form('ktc_hearing_kl_hearing_answer_form', $hearing);
        $node->content['kl_hearing_answer_form']['#weight'] = -10;
      }
    }
  }
}

/**
 * Implement hook_node_insert() and hook_node_presave(), in order to define our
 * own hook for saving a hearing.
 *
 * Defining 'hook_ktc_hearing_save()'.
 */

/**
 * Implements hook_entity_insert().
 */
function ktc_hearing_entity_insert($entity, $type) {
  drupal_register_shutdown_function('_ktc_hearing_trigger_hook', $entity, FALSE, $type);
}

/**
 * Implements hook_entity_update().
 */
function ktc_hearing_entity_update($entity, $type) {
  drupal_register_shutdown_function('_ktc_hearing_trigger_hook', $entity, $entity->original, $type);
}


/**
 * Handler for hearing updates.
 */
function _ktc_hearing_trigger_hook($entity, $original, $type) {
  if ($type == 'node' && $entity->type == 'hearing') {

    $hearing = $entity;
    // If this is an insert operation, no original will be set. We need one for
    // comparison.
    if (!$original) {
      $hearing->original = clone $hearing;
    }
    else {
      $hearing->original = clone $original;
    }

    $modules = module_implements('ktc_hearing_save');

    foreach ($modules as $module) {
      $function = $module . '_ktc_hearing_save';
      if (function_exists($function)) {
        $function($hearing);
      }
    }

  }
}

/**
 * Implements hook_ktc_hearing_save().
 */
function ktc_hearing_ktc_hearing_save($hearing) {
  $hearing_status = ktc_hearing_get_status($hearing);

  if ($hearing->status == 1 && $hearing_status == KTC_HEARING_STATUS_NEW) {
    // Set status to open.
    $language = field_language('node', $hearing, 'field_status');
    $hearing->field_status[$language][0]['tid'] = KTC_HEARING_STATUS_OPEN;
    node_save($hearing);
  }
}

/**
 * Set a KL hearing answer link on the hearing.
 */
function ktc_hearing_kl_hearing_answer_form($form, &$form_state, $hearing) {
  $form_state['hearing'] = $hearing;

  $form['kl_hearing_answer_url'] = array(
    '#type' => 'textfield',
    '#title' => t('Link til KL høringssvar'),
    '#default_value' => 'http://',
  );

  $form['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Gem'),
    '#states' => array(
      'invisible' => array(
        ':input[name="kl_hearing_answer_url"]' => array('value' => 'http://'),
      )
    ),
  );
  return $form;
}

/**
 * Validate handler kl_hearing_answer_form.
 */
function ktc_hearing_kl_hearing_answer_form_validate($form, &$form_state) {
  $url = $form_state['values']['kl_hearing_answer_url'];
  $parts = explode('//', $url);

  if (!url_is_external($url) || !valid_url($url) || !$parts[1]) {
    form_set_error('kl_hearing_answer_url', 'Den indtastede adresse er ikke gyldig.');
  }
}

/**
 * Submithandler, set KL hearing answer link on hearing.
 */
function ktc_hearing_kl_hearing_answer_form_submit(&$form, &$form_state) {
  $hearing = $form_state['hearing'];

  $hearing->field_link_kl_hoeringssvar[LANGUAGE_NONE][0]['url'] = $form_state['values']['kl_hearing_answer_url'];
  node_save($hearing);
}

/**
 * Get a hearing from the response.
 */
function ktc_hearing_get_hearing_from_response($hearing_response) {
  if ($hearing_field = field_get_items('node', $hearing_response, 'field_hearing_node')) {
    return node_load($hearing_field[0]['target_id']);
  }
  return FALSE;
}

/**
 * Page callback allowing the hearing response to be approved.
 */
function ktc_hearing_approve_summary_responses($hearing) {
  if ($summary_response = ktc_hearing_get_summary_response($hearing)) {
    switch (ktc_hearing_get_status($hearing)) {
      case KTC_HEARING_STATUS_APPROVAL:

        module_load_include('inc', 'node', 'node.pages');

        $query = new EntityFieldQuery();
        $query->entityCondition('entity_type', 'node')
          ->propertyCondition('status', 1)
          ->entityCondition('bundle', 'hearing_responses')
          ->fieldCondition('field_hearing_node', 'target_id', $hearing->nid);
        $result = $query->execute();

        if (isset($result['node'])) {
          foreach ($result['node'] as $item) {
            $node = node_load($item->nid);

            if (_ktc_hearing_response_is_summary($node)) {
              continue;
            }

            $vars['responses'][] = node_view($node, 'teaser');
          }
        }

        $type = 'hearing_responses';
        $vars['answer_form'] = render(drupal_get_form($type . '_node_form', $summary_response));
        break;

      case KTC_HEARING_STATUS_APPROVED:
        $answer = node_view($summary_response);
        $vars['preface'] = render($answer) .
          'Sammenfatningen er blevet godkendt.';
        break;

      default:
        $vars['preface'] = 'Sammenfatningen er endnu ikke sendt til godkendelse.';
        break;
    }
  }
  else {
    $vars['preface'] = 'Der er ikke skrevet nogen sammenfatning.';
  }

  drupal_set_title('Godkend sammenfatning: ' . drupal_get_title());
  return theme('hearing_answer', $vars);
}

/**
 * Get summary response for a hearing.
 */
function ktc_hearing_get_summary_response($hearing) {
  // Find the summary response for a hearing.
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'node')
    ->entityCondition('bundle', 'hearing_responses')
    ->fieldCondition('field_is_summary', 'value', 1)
    ->fieldCondition('field_hearing_node', 'target_id', $hearing->nid);
  $result = $query->execute();

  if (isset($result['node'])) {
    // If it exists load the node and return it.
    return node_load(key($result['node']));
  }

  return FALSE;
}

/**
 * Approve summary response form.
 */
function ktc_hearing_approve_summary_response_form($form, $form_state, $summary_response) {
  $form = array();

  $hearing = _ktc_hearing_get_hearing_from_response($summary_response);

  $form['hearing_nid'] = array(
    '#type' => 'hidden',
    '#value' => $hearing->nid,
  );

  $form['status'] = array(
    '#type' => 'hidden',
    '#value' => KTC_HEARING_STATUS_APPROVED,
  );

  $form['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Godkend'),
  );

  $form['#submit'] = array('ktc_hearing_set_status_submit');

  return $form;
}

/**
 * Extra submit handler for sending a response for approval.
 */
function ktc_hearing_set_status_approval(&$form, &$form_state) {
  if ($form_state['clicked_button']['#parents'][0] == 'send_for_approval') {
    $summary_response = $form['#entity'];
    $hearing = node_load(arg(1));

    $values['values']['hearing_nid'] = $hearing->nid;
    $values['values']['status'] = KTC_HEARING_STATUS_APPROVAL;

    $form = array();
    ktc_hearing_set_status_submit($form, $values);
  }
}

/**
 * Extra submit handler for setting a hearing approved.
 */
function ktc_hearing_set_status_approved(&$form, &$form_state) {
  if ($form_state['clicked_button']['#parents'][0] == 'set_approved') {
    $hearing = node_load(arg(1));

    $values['values']['hearing_nid'] = $hearing->nid;
    $values['values']['status'] = KTC_HEARING_STATUS_APPROVED;

    $form = array();
    ktc_hearing_set_status_submit($form, $values);
  }
}

/**
 * Change hearing status.
 */
function ktc_hearing_set_status($form, $form_state, $arg = NULL) {
  if ($arg == NULL) {
    $arg = node_load(arg(1));
  }
  if (is_object($arg)) {
    $status = ktc_hearing_get_status($arg);
    $nid = $arg->nid;
  }
  else {
    $status = $arg;
    $nid = arg(1);
  }

  $hearing_states = array(
    KTC_HEARING_STATUS_OPEN,
    KTC_HEARING_STATUS_RECAP,
    KTC_HEARING_STATUS_APPROVAL,
    KTC_HEARING_STATUS_APPROVED,
    KTC_HEARING_STATUS_CLOSED,
    KTC_HEARING_STATUS_KL_ANSWER,
  );

  foreach ($hearing_states as $state) {
    $state_options[$state] = _ktc_hearing_term_name($state);
  }

  $form['status'] = array(
    '#type' => 'select',
    '#title' => t('Opdater status'),
    '#default_value' => $status,
    '#options' => $state_options,
  );

  $form['hearing_nid'] = array(
    '#type' => 'hidden',
    '#value' => $nid,
  );

  $form['submit'] = array(
    '#type' => 'submit',
    '#value' => 'Ok',
  );

  $form['#attributes'] = array(
    'class' => array(''),
  );

  return $form;
}

/**
 * Submit handler, change hearing status.
 */
function ktc_hearing_set_status_submit(&$form, &$form_state) {
  $node = node_load($form_state['values']['hearing_nid']);

  $language = field_language('node', $node, 'field_status');
  $node->field_status[$language][0]['tid'] = $form_state['values']['status'];

  node_save($node);

  // Set the summary response to be final if the hearing is approved.
  if ($form_state['values']['status'] == KTC_HEARING_STATUS_APPROVED) {
    if ($summary = ktc_hearing_get_summary_response($node)) {
      $summary->field_is_final[LANGUAGE_NONE][0]['value'] = 1;
      node_save($summary);
    }
  }

  drupal_goto('node/' . $node->nid);
}

/**
 * Hearing response page.
 */
function ktc_hearing_responses($hearing) {
  drupal_add_js(drupal_get_path('module', 'ktc_hearing') . '/ktc_hearing_response.js');
  $result = db_select('field_data_field_hearing_node', 'h')
    ->fields('h', array('entity_id'))
    ->condition('field_hearing_node_target_id', $hearing->nid)
    ->execute()
    ->fetchAllKeyed(0,0);

  $type = 'hearing_responses';
  $vars = array();

  $user_decline_respond = FALSE;

  global $user;
  if ($result) {
    foreach ($result as $nid) {
      $node = node_load($nid);

      if (_ktc_hearing_response_is_summary($node)) {
        continue;
      }

      if ($node->uid == $user->uid) {
        if ($field = field_get_items('node', $node, 'field_is_no_answer')) {
          if ($field[0]['value']) {
            $user_decline_respond = TRUE;
          }
        }
        $users_response = $node;
      }

      if ($node->status) {
        $vars['responses'][$node->uid] = node_view($node, 'teaser');
      }
    }
  }

  $node = (object) array(
    'uid' => $user->uid,
    'name' => (isset($user->name) ? $user->name : ''),
    'type' => $type,
    'language' => LANGUAGE_NONE,
  );

  if (isset($users_response)) {
    $node = $users_response;
  }

  if ($field = field_get_items('node', $hearing, 'field_attendees')) {
    foreach ($field as $delta => $value) {
      $_uid = $value['target_id'];

      if (!isset($vars['responses'][$_uid])) {
        $account = user_load($_uid);
        $vars['no_response'][$_uid] = $account->name;
      }
    }
  }

  if (ktc_hearing_access($hearing, 'respond') && ktc_hearing_get_status($hearing) == KTC_HEARING_STATUS_OPEN) {
    $node_form = drupal_get_form($type . '_node_form', $node);
    $node_form['actions']['submit']['#submit'][] = '_ktc_hearings_node_no_redirect';

    $vars['answer_form'] = render($node_form);
  }

  if ($user_decline_respond) {
    $vars['answer_form'] = t('Du har valgt ikke at svare på denne høring.');
  }

  return theme('hearing_answer', $vars);
}

/**
 * Page callback for "don't answer" action.
 */
function ktc_hearing_no_response($hearing) {
  $vars['answer_form'] = render(drupal_get_form('ktc_hearing_no_response_form'));
  return theme('hearing_answer', $vars);
}

/**
 * Form callback - "don't answer" action.
 */
function ktc_hearing_no_response_form($form, &$form_state) {
  $form['no_answer'] = array(
    '#title' => t('Begrundelse for ikke at svare'),
    '#description' => t('Din begrundelse vil være synlig for de andre deltagere.'),
    '#type' => 'text_format',
    '#required' => TRUE,
  );

  $form['submit'] = array(
    '#type' => 'submit',
    '#value' => t('Submit'),
  );

  return $form;
}

/**
 * Submit handler for "don't answer" form.
 */
function ktc_hearing_no_response_form_submit(&$form, &$form_state) {
  $hearing_nid = arg(1);

  global $user;
  $account = user_load($user->uid);
  $user_name = $user->name;

  if ($name_field = field_get_items('user', $account, 'field_navn')) {
    $user_name = $name_field[0]['value'];
  }

  // Load users response, if there is any.
  $hearing = node_load($hearing_nid);

  if ($response_nid = ktc_hearing_user_has_responded($hearing)) {
    $node = node_load($response_nid);
  }

  // If not create a new node.
  if (!isset($node)) {
    $node = new stdClass();
    $node->title = t('Høringssvar') . ': ' . $user_name;
    $node->type = 'hearing_responses';
    node_object_prepare($node);
    $node->language = LANGUAGE_NONE;
    $node->uid = $user->uid;
  }
  $node->status = 1;

  $node->body[LANGUAGE_NONE][] = $form_state['values']['no_answer'];
  $node->field_is_no_answer[LANGUAGE_NONE][]['value'] = 1;
  $node->field_hearing_node[LANGUAGE_NONE][]['target_id'] = $hearing_nid;
  $node = node_submit($node);
  node_save($node);

  $form_state['redirect'] = 'node/' . $hearing_nid;
}

/**
 * Has the user responded to the hearing.
 */
function ktc_hearing_user_has_responded($hearing, $user = FALSE) {
  if (!$user) {
    global $user;
  }

  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'node')
    ->propertyCondition('status', 1)
    ->entityCondition('bundle', 'hearing_responses')
    ->fieldCondition('field_hearing_node', 'target_id', $hearing->nid)
    ->propertyCondition('uid', $user->uid);
  $result = $query->execute();

  if (isset($result['node'])) {
    return key($result['node']);
  }
  return FALSE;
}

/**
 * Retrieve a list of hearings, the user needs to repond to.
 */
function ktc_hearing_get_users_unresponded($account = FALSE) {
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'node')
    ->entityCondition('bundle', 'hearing')
    ->fieldCondition('field_status', 'tid', KTC_HEARING_STATUS_OPEN);

  $result = $query->execute();

  $hearings = array();

  if (isset($result['node'])) {
    foreach ($result['node'] as $nid => $info) {
      $node = node_load($nid);
      if (node_access('view', $node, $account) && !ktc_hearing_user_has_responded($node, $account)) {
        $hearings[$nid] = $nid;
      }
    }
  }

  return $hearings;
}

/**
 * Determine users access to hearing node.
 */
function ktc_hearing_user_has_access($hearing, $account = FALSE) {
  if (!$account) {
    global $user;
    $account = user_load($user->uid);
  }

  $access = array();

  $reference_permissions = _ktc_hearing_reference_permissions();

  // Not all fields in $reference_permissions are direct user references
  // the ones here are.
  $fields = array(
    'chairman',
    'coordinator',
    'attendees',
    'responsible_admin',
    'responsible_foreman',
  );

  // Loop over them and determine what level of acces the user has.
  foreach ($fields as $field_name) {
    if ($field = field_get_items('node', $hearing, 'field_' . $field_name)) {
      if (_ktc_hearing_account_in_field($account->uid, $field) || $account->uid == 1) {
        $access = array_merge($access, $reference_permissions[$field_name]);
      }
    }
  }

  if ($account->uid == $hearing->uid) {
    $access = array_merge($access, $reference_permissions['creator']);
  }

  return $access;
}

/**
 * Get meeting status.
 */
function ktc_hearing_get_status($node) {
  if ($status_field = field_get_items('node', $node, 'field_status')) {
    return $status_field[0]['tid'];
  }

  return KTC_HEARING_STATUS_CLOSED;
}

/**
 * Helper, determine if the hearing is open for responses.
 */
function _ktc_hearing_is_open($hearing) {
  $open_statuses = variable_get('ktc_hearing_status_open', array(0));

  if ($status_field = field_get_items('node', $hearing, 'field_status')) {
    if (in_array($status_field[0]['tid'], $open_statuses)) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Helper, can the user create a hearing.
 */
function _ktc_hearing_user_can_create_hearing($user) {
  // Check if there are groups where the user can create hearings.
  $group_ids = _ktc_hearing_user_can_create_hearing_groups($user->uid);
  if (!empty($group_ids)) {
    return TRUE;
  }

  // If none of the above, deny creating hearings.
  return FALSE;
}

/**
 * Helper, return list of groups, where the user can create hearings.
 */
function _ktc_hearing_user_can_create_hearing_groups($uid) {
  $account = user_load($uid);

  $groups = array();
  $hearings_groups = array();

  // Fetch ids for all networks of this type.
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'node')
    ->fieldCondition('field_netvaerkstype', 'tid', 1134);
  $result = $query->execute();

  if (isset($result['node'])) {
    foreach ($result['node'] as $group_id => $value) {
      $hearing_groups[$group_id] = $group_id;
    }
  }

  if ($usertype_field = field_get_items('user', $account, 'field_usertype')) {
    $usertype_tid = $usertype_field[0]['tid'];
    $allowed_usertypes = variable_get('ktc_hearings_usertype_create', array());
    if (isset($allowed_usertypes[$usertype_tid]) && $allowed_usertypes[$usertype_tid]) {
      $groups = $hearing_groups;
    }
  }

  $allowed_group_roles = variable_get('ktc_hearings_group_roles_create', array());

  if (!empty($allowed_group_roles)) {
    // Check if the user is either chairman, responsible_chairman,
    // responsible_admin, coordinator.
    $query = new EntityFieldQuery();
    $query->entityCondition('entity_type', 'og_membership')
      ->propertyCondition('etid', $uid)
      ->fieldCondition('field_grouprole', 'target_id', array_values($allowed_group_roles), 'IN')
      ->propertyCondition('gid', $hearing_groups, 'IN');
    $result = $query->execute();

    if (isset($result['og_membership'])) {
      // Load memberships and extract group ids.
      $memberships = og_membership_load_multiple(array_keys($result['og_membership']));

      foreach ($memberships as $membership) {
        $groups[$membership->gid] = $membership->gid;
      }
    }
  }

  return $groups;
}

/**
 * Helper, permissions based on reference fields.
 */
function _ktc_hearing_reference_permissions() {
  return array(
    'chairman' => array(
      'approve summary response' => 'approve summary response',
      'link to kl answer' => 'link to kl answer',
      'summary response' => 'summary response',
      'update' => 'update',
      'view' => 'view',
    ),
    'responsible_foreman' => array(
      'approve summary response' => 'approve summary response',
      'link to kl answer' => 'link to kl answer',
      'summary response' => 'summary response',
      'update' => 'update',
      'view' => 'view',
    ),
    'responsible_admin' => array(
      'link to kl answer' => 'link to kl answer',
      'update' => 'update',
      'view' => 'view',
    ),
    'coordinator' => array(
      'link to kl answer' => 'link to kl answer',
      'respond' => 'respond',
      'summary response' => 'summary response',
      'update' => 'update',
      'view responses' => 'view responses',
      'view' => 'view',
    ),
    'attendees' => array(
      'invite' => 'invite',
      'respond' => 'respond',
      'dont respond' => 'dont respond',
      'view responses' => 'view responses',
      'view' => 'view',
    ),
    'creator' => array(
      'link to kl answer' => 'link to kl answer',
      'update' => 'update',
      'view responses' => 'view responses',
      'view summary response' => 'view summary response',
      'view' => 'view',
    ),
  );
}

/**
 * Helper, is user in field values.
 */
function _ktc_hearing_account_in_field($uid, $field) {
  foreach ($field as $delta => $value) {
    if ($uid == $value['target_id']) {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Is response summary.
 */
function _ktc_hearing_response_is_summary($response) {
  if ($summary_field = field_get_items('node', $response, 'field_is_summary')) {
    return $summary_field[0]['value'];
  }
  return FALSE;
}

/**
 * Helper, fetch the hearing node from the response node.
 */
function _ktc_hearing_get_hearing_from_response($response) {
  if ($hearing_field = field_get_items('node', $response, 'field_hearing_node')) {
    return node_load($hearing_field[0]['target_id']);
  }
  return FALSE;
}

/**
 * Helper, generate pdf from hearing node.
 */
function ktc_hearing_generate_pdf($markup) {
  $dompdf = new DOMPDF();
  $dompdf->load_html($markup);
  $dompdf->render();
  return file_unmanaged_save_data($dompdf->output(), NULL, FILE_EXISTS_RENAME);
}

/**
 * Page preview, for summary answer pdf.
 */
function ktc_hearing_generate_hearing_summary_preview($hearing) {
  $markup = ktc_hearing_generate_hearing_summary_view($hearing, TRUE);

  $dompdf = new DOMPDF();
  $dompdf->load_html($markup);

  $dompdf->render();

  $dompdf->stream('test.pdf', array("Attachment" => 0));
  // If we don't call drupal_exit, something makes drupal think that the
  // HTTP headers were modified, and that results in an error message.
  drupal_exit();
}

/**
 * Generate markdown, "clear text" from html.
 */
function ktc_hearing_generate_markdown($markup) {
  $markdown = new HTML_To_Markdown(nl2br($markup));
  $markdown = utf8_decode(strip_tags($markdown->output()));
  return file_unmanaged_save_data($markdown, NULL, FILE_EXISTS_RENAME);
}

/**
 * Gnerate markup of hearing summary answer.
 */
function ktc_hearing_generate_hearing_summary_view($hearing, $php_script = FALSE) {
  $vars = array();

  global $base_url;
  $module_path = drupal_get_path('module', 'ktc_hearing');
  $summary = ktc_hearing_get_summary_response($hearing);

  $vars['style_sheet_url'] = $base_url . '/' . $module_path . '/css/summary_hearing_answer.css';
  $vars['hearing_node'] = $hearing;
  $vars['summary_node'] = $summary;
  $vars['php_script'] = $php_script;

  return theme('summary_hearing_answer', $vars);
}

/**
 * Don't redirect node forms.
 */
function _ktc_hearing_redirect_to_hearing(&$form, &$form_state) {
  $hearing_nid = $form_state['node']->field_hearing_node[LANGUAGE_NONE][0]['target_id'];
  $form_state['redirect'] = 'node/' . $hearing_nid . '/hearing_response';
}

/**
 * Get a users unresponded hearings.
 */
function _ktc_hearing_get_unresponded($user = FALSE) {
  if (!$user) {
    global $user;
  }

  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'node')
    ->entityCondition('bundle', 'hearing')
    ->fieldCondition('field_status', 'tid', KTC_HEARING_STATUS_OPEN)
    ->propertyOrderBy('created', 'DESC');;
  $result = $query->execute();

  $unresponded_hearings = array();

  if (isset($result['node'])) {
    foreach (node_load_multiple(array_keys($result['node'])) as $hearing) {
      // Does the user have the correct permissions?
      // Has the user responded already.
      if (ktc_hearing_access($hearing, 'respond') && !ktc_hearing_user_has_responded($hearing, $user)) {
        $node_author = user_load($hearing->uid);
        $hearing->user_mail = $node_author->mail;
        $unresponded_hearings[$hearing->nid] = $hearing;
      }
    }
  }
  return $unresponded_hearings;
}
/**
 * Get a users unresponded hearings.
 */
function _ktc_hearing_get_unresponded_nids($user = FALSE) {
  if ($hearings = _ktc_hearing_get_unresponded($user)) {
    return array_keys(_ktc_hearing_get_unresponded($user));
  }
  return array(0);
}

/**
 * Get the label for the status form the taxonomy.
 */
function _ktc_hearing_term_name($term_id) {
  $term = taxonomy_term_load($term_id);
  return $term->name;
}

/**
 * Generate an array containing info about the current hearing.
 */
function _ktc_hearing_get_info_vars($node = NULL) {
  // Defines the following variables for the template.
  //
  // Titel                      => $title
  // Kort titel                 => $short_title
  // Myndighed                  => $authority
  // Høringstype                => $type
  // Status                     => $status
  // Gruppe/Netværk             => $group
  // Ansvarlig formand          => $responsible_foreman
  // Ansvarlig tovholder        => $responsible_chairman
  // Din svarfrist              => $answer_by (datetime)
  // Løbenummer / id            => $nid
  // Oprettet af                => $author
  // Oprettet dato              => $created (unix timestamp)
  // Antal deltagere            => $attendee_count
  // Antal deltagere har svaret => $answer_count
  // Din status i høringen      => $role
  $vars = array();

  if ($node == NULL) {
    $node = menu_get_object('node');
  }
  if ($node->type == 'hearing') {

    // Titel og Løbenummer / id.
    $vars['title'] = $node->title;
    $vars['nid'] = $node->nid;

    // Oprettet af.
    $vars['author'] = _ktc_hearing_get_user_name($node->uid);

    if ($field = field_get_items('node', $node, 'field_titel_kort')) {
      $vars['short_title'] = $field[0]['value'];
    }

    if ($field = field_get_items('node', $node, 'field_responsible_admin')) {
      $vars['responsible_chairman'] = _ktc_hearing_get_user_name($field[0]['target_id']);
    }

    if ($field = field_get_items('node', $node, 'field_responsible_foreman')) {
      $vars['responsible_foreman'] = _ktc_hearing_get_user_name($field[0]['target_id']);
    }

    $vars['created'] = $node->created;

    if ($field = field_get_items('node', $node, 'field_hearing_type')) {
      $vars['type'] = _ktc_hearing_term_name($field[0]['tid']);
    }

    if ($field = field_get_items('node', $node, 'field_status')) {
      $vars['status'] = _ktc_hearing_term_name($field[0]['tid']);
    }

    if ($field = field_get_items('node', $node, 'field_attendees')) {
      $vars['attendee_count'] = count($field);
    }

    if ($field = field_get_items('node', $node, 'field_hearing_authority')) {
      $vars['authority'] = $field[0]['value'];
    }

    if ($field = field_get_items('node', $node, 'og_group_ref')) {
      $group = node_load($field[0]['target_id']);
      $vars['group'] = $group->title;
    }

    $role = _ktc_hearing_get_user_role($node);
    $vars['role'] = reset($role);

    $vars['answer_count'] = _ktc_hearing_count_answers($node);

    $vars['answer_by'] = _ktc_hearing_user_answer_date($node, $role);
  }

  return $vars;
}

/**
 * Get users real name.
 */
function _ktc_hearing_get_user_name($uid) {
  $account = user_load($uid);
  $name = array();

  if ($field = field_get_items('user', $account, 'field_navn')) {
    $name[] = trim($field[0]['value']);
  }
  if ($field = field_get_items('user', $account, 'field_efternavn')) {
    $name[] = trim($field[0]['value']);
  }
  return implode(' ', $name);
}

/**
 * Get the current users role in a hearing.
 */
function _ktc_hearing_get_user_role($node) {
  global $user;

  // Find out if user uid is in the fields data.
  $uid_id_field = function($field, $uid) {
    foreach ($field as $_val) {
      if ($_val['target_id'] == $uid) {
        return TRUE;
      }
    }
  };

  // Map of fieldnames to pretty role titles.
  $field_map = array(
    'field_responsible_foreman' => 'Ansvarlig formand',
    'field_responsible_admin' => 'Ansvarlig tovholder',
    'field_chairman' => 'Formand',
    'field_coordinator' => 'Tovholder',
    'field_attendees' => 'Deltager',
  );

  foreach ($field_map as $field_name => $role_title) {
    if ($field = field_get_items('node', $node, $field_name)) {
      if ($uid_id_field($field, $user->uid)) {
        return array($field_name => $role_title);
      }
    }
  }
  return array('none' => 'Deltager ikke');
}

/**
 * Get numbers of answeres given on a hearing.
 */
function _ktc_hearing_count_answers($node) {
  // Query hearing_responses nodes referencing the hearing.
  $query = new EntityFieldQuery();
  $query->entityCondition('entity_type', 'node')
    ->propertyCondition('status', 1)
    ->entityCondition('bundle', 'hearing_responses')
    ->fieldCondition('field_hearing_node', 'target_id', $node->nid);
  $result = $query->execute();

  if (isset($result['node'])) {
    return count($result['node']);
  }
}

/**
 * Get date the user should answer hearing by.
 */
function _ktc_hearing_user_answer_date($node, $role) {
  // Don't return a date, if the user has no role.
  if (key($role) == 'none') {
    return '';
  }

  // Attendees have the normal deadline.
  if (key($role) == 'field_attendees') {
    if ($field = field_get_items('node', $node, 'field_attendee_deadlines')) {
      $formatted = field_view_value('node', $node, 'field_attendee_deadlines', $field[0], array(
        'settings' => array(
          'format_type' => 'medium'
        )
      ));

      return $formatted['#markup'];
    }
  }

  // Chairman and foreman have other deadlines.
  if ($field = field_get_items('node', $node, 'field_enrollment_deadlines')) {
    $formatted = field_view_value('node', $node, 'field_enrollment_deadlines', $field[0], array(
      'settings' => array(
        'format_type' => 'medium'
      )
    ));

    return $formatted['#markup'];
  }
}
